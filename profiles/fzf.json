        {
          "flag": "--multi",
          "argument": "[=MAX]",
          "summary": "Allow multiple selections; optional MAX counts items",
          "argument_optional": true,
          "optional_value_kind": "nonnegative_integer",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "ref": "selection-limit"
              }
            ]
          },
          "detail": "fzf 0.60.3: the optional integer is the maximum number of selected input items. Without MAX, multi-selection has no explicit user cap. Zero disables multi-selection; it does not mean unlimited."
        },
        {
          "flag": "-m",
          "argument": "MAX",
          "argument_optional": true,
          "optional_value_kind": "nonnegative_integer",
          "attached": true,
