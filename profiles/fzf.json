        {
          "flag": "--height",
          "argument": "HEIGHT",
          "summary": "Set height in terminal rows or percent of terminal height",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "quantity",
                "meaning": "Finder window height",
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/junegunn/fzf/v0.60.3/man/man1/fzf.1",
                      "locator": "--multi, --height, --nth and FIELD INDEX EXPRESSION"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/junegunn/fzf/v0.60.3/src/options.go",
                      "locator": "parseHeight and parseSize"
                    }
                  ]
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "fzf"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "0.60.3"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "This parameter definition does not select an operating system; platform availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed"
                  }
                },
                "bare": {
                  "state": "accepted",
                  "form": "rows"
                },
                "forms": [
                  {
                    "id": "rows",
                    "notation": "number",
                    "syntax": "N",
                    "unit": {
                      "base": "row",
                      "multiplier": "1"
                    },
                    "bounds": {
                      "min": "0"
                    },
                    "grammar": "Nonnegative integer terminal-row count"
                  },
                  {
                    "id": "percentage",
                    "notation": "suffix",
                    "syntax": "N%",
                    "tokens": [
                      "%"
                    ],
                    "case": "sensitive",
                    "unit": {
                      "base": "ratio",
                      "multiplier": "0.01",
                      "relative_to": "terminal height"
                    },
                    "bounds": {
                      "min": "0",
                      "max": "100"
                    }
                  },
                  {
                    "id": "inverse-rows",
                    "notation": "expression",
                    "syntax": "-N",
                    "grammar": "Subtract N terminal rows from terminal height; the minus is a layout modifier",
                    "unit": {
                      "base": "row",
                      "multiplier": "1"
                    }
                  },
                  {
                    "id": "inverse-percent",
                    "notation": "expression",
                    "syntax": "-N%",
                    "grammar": "Subtract this percentage of terminal height; the minus is a layout modifier",
                    "unit": {
                      "base": "ratio",
                      "multiplier": "0.01",
                      "relative_to": "terminal height"
                    }
                  },
                  {
                    "id": "adaptive-rows",
                    "notation": "expression",
                    "syntax": "~N",
                    "grammar": "Adapt to input size up to N terminal rows; a negative adaptive height is invalid",
                    "unit": {
                      "base": "row",
                      "multiplier": "1"
                    }
                  },
                  {
                    "id": "adaptive-percent",
                    "notation": "expression",
                    "syntax": "~N%",
                    "grammar": "Adapt to input size up to this percentage of terminal height; a negative adaptive height is invalid",
                    "unit": {
                      "base": "ratio",
                      "multiplier": "0.01",
                      "relative_to": "terminal height"
                    }
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Use the default full-screen display unless other display options apply"
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "This option requires an operand"
                }
              }
            ]
          },
          "detail": "fzf 0.60.3: bare integers count terminal rows; a % suffix is a percentage of terminal height (0-100). A leading - subtracts from terminal height; ~ enables adaptive height based on input size. Adaptive height cannot be negative and has additional percentage-margin/padding limitations. These are layout forms, not byte or time quantities."
        },
