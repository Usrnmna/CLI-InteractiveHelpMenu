          "argument": "RANGES",
          "summary": "Select matching fields by 1-based indices or ranges",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "index",
                "meaning": "Fields included in matching",
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/junegunn/fzf/v0.60.3/man/man1/fzf.1",
