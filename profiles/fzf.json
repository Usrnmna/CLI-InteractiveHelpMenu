                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed"
                  }
                },
                "bare": {
                  "state": "accepted",
                  "form": "index"
                },
                "forms": [
                  {
                    "id": "index",
                    "notation": "number",
                    "syntax": "N",
                    "grammar": "A nonzero signed decimal integer; positive indices start at 1 and -1 is the last field"
                  },
                  {
                    "id": "fields",
                    "notation": "expression",
                    "syntax": "N[,N..M,...]",
                    "grammar": "Comma-separated nonzero integer indices or inclusive ranges; positive indices start at 1, -1 is the last field, and open endpoints select the beginning/end"
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Search all fields"
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "This option requires an operand"
                },
                "subject": "Input fields after any --with-nth transformation",
                "origin": "1"
              }
            ]
          },
          "detail": "fzf 0.60.3: use comma-separated field expressions, such as 1,3..5,-1. Positive indices start at 1; negative indices count from the end (-1 is last); zero is not a field index. Ranges are inclusive, and omitted endpoints extend to the first/last field. Indices apply after --with-nth transformation when that option is used."
        },
