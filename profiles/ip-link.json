      "options": [
        {
          "argument": "",
          "flag": "show",
          "kind": "keyword",
          "summary": "List network interfaces",
          "detail": "With no arguments, ip link lists the interfaces in the current network namespace. Use show before listing filters."
        },
        {
          "argument": "IFNAME",
          "flag": "dev",
          "kind": "keyword",
          "summary": "Show one interface by name",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "identifier",
                "meaning": "Network interface name",
                "bare": {
