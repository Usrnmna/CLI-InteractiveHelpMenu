                },
                "forms": [
                  {
                    "id": "text",
                    "notation": "expression",
                    "syntax": "VALUE",
                    "grammar": "Interface/device name from the network namespace; digits in a name do not imply an interface index or numerical unit."
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Do not add this device-name restriction."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "iproute2"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "6.13.0"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
