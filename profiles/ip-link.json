                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/iproute2/iproute2/v6.13.0/man/man8/ip-link.8.in",
                      "locator": "ip link show, dev NAME"
                    }
                  ]
                },
                "subject": "Network interfaces"
              }
            ]
          },
          "detail": "Use dev lo to inspect the loopback device and its flags."
        },
        {
          "argument": "",
          "flag": "up",
          "kind": "keyword",
          "summary": "Show administratively up interfaces",
          "detail": "An interface can be up even when it has no carrier."
