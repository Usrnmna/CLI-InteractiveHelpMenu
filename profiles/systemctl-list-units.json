{
  "categories": [
    {
      "description": "Unit selection and table output.",
      "name": "Arguments",
      "options": [
        {
          "argument": "",
          "flag": "--user",
          "summary": "Use the current user’s service manager",
          "detail": "Selects units managed for the calling user."
        },
        {
          "argument": "",
          "flag": "--system",
          "summary": "Use the system service manager",
          "detail": "This is the default manager."
        },
        {
          "argument": "",
          "flag": "--no-pager",
          "summary": "Write output without a pager"
        },
        {
          "argument": "",
          "flag": "--no-legend",
          "summary": "Hide the table header and footer",
          "detail": "Equivalent to --legend=no. The unit rows remain visible."
        },
        {
          "argument": "",
          "flag": "--full",
          "summary": "Print full unit names and descriptions",
          "detail": "Long text can extend beyond the terminal width."
        },
        {
          "argument": "",
          "flag": "--all",
          "summary": "Include inactive units held in memory",
          "detail": "Also includes units that follow another unit. Use list-unit-files to see installed files, including uninstantiated templates."
        },
        {
          "argument": "TYPE",
          "flag": "--type=",
          "summary": "List units of the selected types",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "enumeration",
                "meaning": "systemd unit types",
                "bare": {
                  "state": "not_applicable",
                  "reason": "This is a text/selector grammar, not an unsuffixed scalar measurement"
                },
                "forms": [
                  {
                    "id": "text",
                    "notation": "expression",
                    "syntax": "VALUE",
                    "grammar": "Comma-separated unit-type names such as service, socket, target, timer, device, mount, automount, swap, path, slice and scope; help requests the supported type list."
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Do not add a unit-type filter."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "systemd"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "257"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/systemd/systemd/v257/man/systemctl.xml",
                      "locator": "--type"
                    }
                  ]
                }
              }
            ]
          },
          "detail": "Give a comma-separated list such as service,timer. Use help for the installed type names. Ubuntu 24.04 and 26.04 require a value after =."
        },
        {
          "argument": "STATE",
          "flag": "--state=",
          "summary": "List units matching any selected state",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "enumeration",
                "meaning": "systemd unit state names",
                "bare": {
                  "state": "not_applicable",
                  "reason": "This is a text/selector grammar, not an unsuffixed scalar measurement"
                },
                "forms": [
                  {
                    "id": "text",
                    "notation": "expression",
                    "syntax": "VALUE",
                    "grammar": "Comma-separated load, active or substate names, such as loaded, active, inactive, failed or running; meanings and available substates depend on unit type. help requests the state-name list."
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Use the selected subcommand's normal state filtering."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "systemd"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "257"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/systemd/systemd/v257/man/systemctl.xml",
                      "locator": "--state"
                    }
                  ]
                }
              }
            ]
          },
          "detail": "Use a load state (masked), active state (failed) or substate (running). Separate alternatives with commas. Ubuntu 24.04 and 26.04 require a value after =."
        },
        {
          "argument": "",
          "flag": "--plain",
          "summary": "Omit the status symbols beside unit names",
          "detail": "The text columns still show load, active and substate values."
        },
        {
          "argument": "LINES",
          "detail": "The unit table has no row limit controlled by --lines=.",
          "flag": "--lines=",
          "summary": "Set the journal count for status only",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "applicability": {
                  "chip": {
                    "reason": "No chip-specific interpretation is claimed",
                    "state": "not_applicable"
                  },
                  "implementation": {
                    "state": "known",
                    "values": [
                      "systemd"
                    ]
                  },
                  "platform": {
                    "state": "known",
                    "values": [
                      "Linux"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "257"
                    ]
                  }
                },
                "bare": {
                  "form": "lines",
                  "state": "accepted"
                },
                "forms": [
                  {
                    "bounds": {
                      "min": "0"
                    },
                    "grammar": "Decimal integer journal-line count",
                    "id": "lines",
                    "notation": "number",
                    "special_values": [
                      {
                        "meaning": "Suppress the status journal output",
                        "value": "0"
                      }
                    ],
                    "syntax": "N"
                  }
                ],
                "kind": "count",
                "meaning": "Journal lines included in systemctl status output",
                "review": {
                  "references": [
                    {
                      "locator": "--lines applies to status; zero disables journal output; default 10",
                      "source": "https://www.freedesktop.org/software/systemd/man/257/systemctl.html"
                    }
                  ],
                  "status": "verified"
                },
                "subject": "Recent journal lines for status output",
                "when_absent": {
                  "form": "lines",
                  "state": "known",
                  "value": "10"
                },
                "when_value_omitted": {
                  "reason": "This option requires an operand",
                  "state": "not_accepted"
                }
              }
            ]
          }
        },
