                    "bounds": {
                      "min": "0"
                    },
                    "grammar": "Decimal integer journal-line count",
                    "id": "lines",
                    "notation": "number",
                    "special_values": [
                      {
                        "meaning": "Suppress the status journal output",
                        "value": "0"
                      }
                    ],
                    "syntax": "N"
