{
  "categories": [
    {
      "description": "Control which files are copied and how directory trees are traversed.",
      "name": "Transfer",
      "options": [
        {
          "detail": "Archive mode (-a) uses -rlptgoD for recursion, symlinks, permissions, modification times, group, owner, devices and special files. With --files-from, add -r to recurse. Hard links (-H), ACLs (-A), extended attributes (-X), access times (-U) and creation times (-N) are separate.",
          "flag": "--archive",
          "summary": "Copy a tree with its metadata"
        },
        {
          "detail": "Use --dirs to copy directory entries without descending into them.",
          "flag": "--recursive",
          "summary": "Copy directory trees"
        },
        {
          "detail": "For regular files, equal modification times still permit an update when sizes differ. Directories, symlinks and type changes bypass the newer-file check. An interrupted --inplace update can leave a newer partial file that a retry skips.",
          "flag": "--update",
          "summary": "Skip newer destination files"
        },
        {
          "detail": "Existing directories are still traversed. This transfer rule does not protect destination-only files from deletion.",
          "flag": "--ignore-existing",
          "summary": "Skip files already at the destination"
        }
      ]
    },
    {
      "description": "Inspect proposed changes before running a transfer.",
      "name": "Preview",
      "options": [
        {
          "detail": "Use --itemize-changes to list proposed changes. No file data is sent. Progress and transfer statistics cannot predict a real run.",
          "flag": "--dry-run",
          "summary": "Preview changes without writing files"
        },
        {
          "detail": "The first two characters identify the update and file type. The remaining characters mark changed attributes. Repeat -i to list unchanged items too (receiver 2.6.7 or later).",
          "flag": "--itemize-changes",
          "summary": "List file and attribute changes"
        }
      ]
    },
