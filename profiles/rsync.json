{
  "command": [
    "rsync"
  ],
  "description": "Copy and synchronize files locally or over a remote transport.",
  "categories": [
    {
      "name": "Transfer",
      "description": "Control which files are copied and how directory trees are traversed.",
      "options": [
        {
          "flag": "--archive",
          "summary": "Enable archive mode",
          "detail": "Equivalent to -rlptgoD. Preserves common file attributes and recurses into directories. ACLs, extended attributes, and hard links require separate options."
        },
        {
          "flag": "--recursive",
          "summary": "Recurse into directories"
        },
        {
          "flag": "--update",
          "summary": "Skip files newer at the destination"
        },
        {
          "flag": "--ignore-existing",
          "summary": "Skip destination files that already exist"
        }
      ]
    },
    {
      "name": "Preview",
      "description": "Inspect proposed changes before running a transfer.",
      "options": [
        {
          "flag": "--dry-run",
          "summary": "Show a trial run without changing files",
          "detail": "Combine with --itemize-changes to inspect planned updates. Selecting this option only inserts text into the shell buffer."
        },
        {
          "flag": "--itemize-changes",
          "summary": "Summarize changes for each file"
        }
      ]
    },
    {
      "name": "Filtering",
      "description": "Include and exclude paths using rsync pattern syntax.",
      "options": [
        {
          "flag": "--exclude=",
          "argument": "PATTERN",
          "summary": "Exclude matching paths",
          "detail": "The cursor remains after the equals sign. Enter and quote the pattern as required by Bash."
        },
        {
          "flag": "--include=",
          "argument": "PATTERN",
          "summary": "Include matching paths"
        },
        {
          "flag": "--exclude-from=",
          "argument": "FILE",
          "summary": "Read exclusion patterns from a file"
        }
      ]
    },
    {
      "name": "Output",
      "description": "Control status and diagnostic output.",
      "options": [
        {
          "flag": "--verbose",
          "summary": "Increase output detail"
        },
        {
          "flag": "--progress",
          "summary": "Show transfer progress"
        },
        {
          "flag": "--human-readable",
          "summary": "Scale printed numbers by 1000; repeat for 1024",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "enumeration",
                "meaning": "Increment the printed-number readability level",
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/RsyncProject/rsync/v3.4.1/rsync.1.md",
                      "locator": "--bwlimit, --max-size, --timeout, --human-readable and --rsh"
                    }
                  ]
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "rsync"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "3.4.1"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "This parameter definition does not select an operating system; platform availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed"
                  }
                },
                "bare": {
                  "state": "not_applicable",
                  "reason": "This complete flag selects a mode and has no numerical operand"
                },
                "forms": [
                  {
                    "id": "selected",
                    "notation": "literal",
                    "syntax": "--human-readable",
                    "tokens": [
                      "--human-readable"
                    ],
                    "case": "sensitive",
                    "meaning": "Increment the printed-number readability level"
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Default mode and other options/configuration remain applicable"
                },
                "when_value_omitted": {
                  "state": "not_applicable",
                  "reason": "This fixed flag has no operand"
                }
              }
            ]
          },
          "detail": "rsync 3.4.1 defaults to level 1 (digit grouping). One occurrence selects level 2 using powers of 1000; a second selects level 3 using powers of 1024. Printed K/M/G/T/P letters do not by themselves identify the scale. The flag takes no number and does not change --bwlimit input units. Releases before 3.1.0 have different starting levels."
        },
        {
          "flag": "--stats",
          "summary": "Show transfer statistics"
        },
        {
          "flag": "--quiet",
          "summary": "Suppress non-error messages"
        }
      ]
    },
