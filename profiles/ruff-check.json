        {
          "argument": "",
          "argument_optional": false,
          "flag": "--fix",
          "summary": "Apply available lint fixes to files",
          "detail": "Safe fixes are enabled by default. Remaining violations are still reported and normally give exit status 1."
        },
        {
          "argument": "",
          "argument_optional": false,
          "flag": "--unsafe-fixes",
          "summary": "Allow fixes that may change behavior",
          "detail": "Use with --fix to apply them or --diff to inspect them. Enabling unsafe fixes alone does not turn on fixing."
        },
        {
          "argument": "",
          "argument_optional": false,
          "flag": "--diff",
          "summary": "Show lint fixes without writing files",
          "detail": "Implies --fix-only. Exit 1 if a fix would change a file. An unfixable violation alone produces no diff and exits 0."
        },
