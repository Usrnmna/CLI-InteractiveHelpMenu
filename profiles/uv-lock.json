        {
          "argument": "",
          "argument_optional": false,
          "flag": "--upgrade",
          "summary": "Allow all locked packages to upgrade",
          "detail": "Refresh cached package data and select versions allowed by the project’s constraints."
        },
        {
          "argument": "PACKAGE",
          "argument_optional": false,
          "flag": "--upgrade-package",
          "summary": "Allow an upgrade for one named package",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "delegated",
                "meaning": "Package upgrade request",
                "bare": {
                  "state": "not_applicable",
                  "reason": "This is a text/selector grammar, not an unsuffixed scalar measurement"
                },
                "forms": [
                  {
                    "id": "text",
                    "notation": "expression",
                    "syntax": "VALUE",
                    "grammar": "Package name optionally followed by a version constraint; constraint numbers are package versions, not measured values."
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Preserve existing locked versions where permitted by the resolution."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
