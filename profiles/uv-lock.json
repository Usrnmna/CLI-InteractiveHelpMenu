                      "uv"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "0.6.14"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/astral-sh/uv/0.6.14/docs/reference/cli.md",
                      "locator": "uv-lock --upgrade-package"
                    }
                  ]
                },
                "grammar": {
                  "name": "Package upgrade request",
                  "reference": {
                    "source": "https://raw.githubusercontent.com/astral-sh/uv/0.6.14/docs/reference/cli.md",
                    "locator": "uv-lock --upgrade-package"
                  }
                }
              }
            ]
          },
          "detail": "Refresh this package and reconsider its locked version. An optional version constraint narrows the choice."
        },
        {
          "argument": "",
          "argument_optional": false,
          "flag": "--check",
          "summary": "Check that the lockfile is current",
          "detail": "Exit with an error if uv.lock is missing or stale. Equivalent to --locked."
        },
        {
          "argument": "",
          "argument_optional": false,
          "flag": "--check-exists",
          "summary": "Check only that the lockfile exists",
          "detail": "A stale lockfile passes this check. Use --check to verify freshness."
        },
        {
          "argument": "STRATEGY",
          "argument_optional": false,
          "flag": "--resolution",
          "summary": "Choose which compatible versions to prefer",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "enumeration",
                "meaning": "Dependency resolution strategy",
                "bare": {
                  "state": "not_applicable",
                  "reason": "This is a text/selector grammar, not an unsuffixed scalar measurement"
                },
                "forms": [
                  {
                    "id": "choice-1",
                    "notation": "literal",
                    "syntax": "highest",
                    "tokens": [
                      "highest"
                    ],
                    "case": "sensitive",
                    "meaning": "Prefer the highest compatible versions"
                  },
                  {
                    "id": "choice-2",
                    "notation": "literal",
                    "syntax": "lowest",
                    "tokens": [
                      "lowest"
                    ],
                    "case": "sensitive",
                    "meaning": "Prefer the lowest compatible versions"
                  },
                  {
                    "id": "choice-3",
                    "notation": "literal",
                    "syntax": "lowest-direct",
                    "tokens": [
                      "lowest-direct"
                    ],
                    "case": "sensitive",
                    "meaning": "Prefer lowest direct dependencies and highest transitive versions"
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Use configured strategy; the built-in default is highest."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "uv"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "0.6.14"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/astral-sh/uv/0.6.14/docs/reference/cli.md",
                      "locator": "--resolution"
                    }
                  ]
                }
              }
            ]
          },
          "detail": "highest prefers newer versions. lowest prefers older ones. lowest-direct prefers older direct dependencies and newer transitive ones."
        },
