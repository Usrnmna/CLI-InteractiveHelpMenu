                  {
                    "id": "choice-3",
                    "notation": "literal",
                    "syntax": "O",
                    "tokens": [
                      "O"
                    ],
                    "case": "sensitive",
                    "meaning": "Odd parity"
                  },
                  {
                    "id": "choice-4",
                    "notation": "literal",
                    "syntax": "S",
                    "tokens": [
                      "S"
                    ],
                    "case": "sensitive",
                    "meaning": "Space parity"
                  },
                  {
                    "id": "choice-5",
                    "notation": "literal",
                    "syntax": "M",
                    "tokens": [
                      "M"
                    ],
                    "case": "sensitive",
                    "meaning": "Mark parity"
