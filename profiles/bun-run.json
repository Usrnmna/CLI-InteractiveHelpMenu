      "options": [
        {
          "argument": "",
          "argument_optional": false,
          "flag": "--watch",
          "summary": "Restart Bun when source files change",
          "detail": "Bun watches the entry file and its imports. Each restart runs the program again with fresh global state."
        },
        {
          "argument": "",
          "argument_optional": false,
          "flag": "--hot",
          "summary": "Reload code in the running Bun process",
          "detail": "An edit to the entry file or an imported source file reruns the modules. Values stored on globalThis survive the reload."
        },
        {
          "argument": "",
          "argument_optional": false,
          "flag": "--bun",
          "summary": "Use Bun for Node.js scripts",
          "detail": "Package scripts and executables that invoke node through PATH, including a #!/usr/bin/env node shebang, use the Bun runtime."
        },
        {
          "argument": "",
          "argument_optional": false,
          "flag": "--silent",
          "summary": "Hide the package script’s command line",
          "detail": "The script still runs and can write to stdout and stderr."
        },
        {
          "argument": "",
          "argument_optional": false,
          "flag": "--if-present",
          "summary": "Succeed if the requested entry point is missing",
          "detail": "Bun still looks for a file or executable when no package script matches. A command it finds can still exit with an error."
        },
