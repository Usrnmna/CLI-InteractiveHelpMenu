      "options": [
        {
          "flag": "--index",
          "argument": "",
          "argument_optional": false,
          "summary": "Try to restore the saved staging state",
          "detail": "Restore the saved index as well as working-tree changes. Conflicts can prevent the index from being restored. On Git 2.53 and current upstream, stash.index=true enables this by default. Git 2.43 requires the switch."
        },
        {
          "flag": "-q",
          "argument": "",
          "argument_optional": false,
          "summary": "Suppress stash feedback",
          "detail": "Errors are still reported. --no-quiet cancels quiet mode."
        },
