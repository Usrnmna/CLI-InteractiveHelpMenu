{
  "categories": [
    {
      "description": "Choose the matching syntax and comparison rules.",
      "name": "Matching",
      "options": [
        {
          "flag": "--ignore-case",
          "summary": "Ignore case distinctions"
        },
        {
          "flag": "--extended-regexp",
          "summary": "Interpret extended regular expressions"
        },
        {
          "flag": "--fixed-strings",
          "summary": "Interpret patterns as literal strings"
        },
        {
          "flag": "--word-regexp",
          "summary": "Match whole words"
        },
        {
          "flag": "--invert-match",
          "summary": "Select non-matching lines"
        },
        {
          "argument": "PATTERN",
          "flag": "--regexp=",
          "summary": "Specify a search pattern",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "nonnumerical",
                "meaning": "Search pattern",
                "bare": {
                  "state": "not_applicable",
                  "reason": "This is a text/selector grammar, not an unsuffixed scalar measurement"
                },
                "forms": [
                  {
                    "id": "text",
                    "notation": "expression",
                    "syntax": "VALUE",
                    "grammar": "Pattern interpreted by the selected basic/extended/Perl regexp or fixed-string mode; repeated patterns provide alternatives."
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Use the positional pattern or patterns selected through other options."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "GNU grep"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "3.11"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://ftp.gnu.org/gnu/grep/grep-3.11.tar.xz",
                      "locator": "doc/grep.texi: Matching Control --regexp"
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "description": "Choose the information printed for matches.",
      "name": "Output",
      "options": [
        {
          "flag": "--line-number",
          "summary": "Print line numbers"
        },
        {
          "flag": "--count",
          "summary": "Print matching-line counts"
        },
        {
          "flag": "--files-with-matches",
          "summary": "Print names of files containing matches"
        },
        {
          "flag": "--only-matching",
          "summary": "Print only matched portions of lines"
        },
        {
          "argument": "LINES",
          "detail": "Nonnegative base-10 integer, without unit suffix. Zero adds no context. Counts apply separately before and after each match; overlapping groups are merged. Overflow saturates at the implementation's intmax_t maximum instead of imposing a smaller guessed fixed limit. Reference scope: GNU grep 3.11.",
          "flag": "--context=",
          "summary": "Print surrounding context lines",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "count",
                "meaning": "Context lines on each side of a match",
                "bare": {
                  "state": "accepted",
                  "form": "count"
                },
                "forms": [
                  {
                    "id": "count",
                    "notation": "number",
                    "syntax": "N",
                    "grammar": "Nonnegative base-10 integer, without unit suffix. Zero adds no context. Counts apply separately before and after each match; overlapping groups are merged. Overflow saturates at the implementation's intmax_t maximum instead of imposing a smaller guessed fixed limit.",
                    "bounds": {
                      "min": "0"
                    },
                    "special_values": [
                      {
                        "value": "0",
                        "meaning": "Do not add surrounding context lines"
                      }
                    ]
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Add no surrounding context through this option."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "GNU grep"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "3.11"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://ftp.gnu.org/gnu/grep/grep-3.11.tar.xz",
                      "locator": "src/grep.c: context_length_arg xstrtoimax base 10 and overflow saturation"
                    },
                    {
                      "source": "https://ftp.gnu.org/gnu/grep/grep-3.11.tar.xz",
                      "locator": "doc/grep.texi: Context Line Control --context"
                    }
                  ]
                },
                "subject": "Lines before and after each matching line"
              }
            ]
          }
        }
      ]
    },
