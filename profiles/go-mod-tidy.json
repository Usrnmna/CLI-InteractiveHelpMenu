        {
          "flag": "-modcacherw",
          "argument": "",
          "argument_optional": false,
          "summary": "Keep new module-cache directories writable",
          "detail": "Go normally makes newly created module-cache directories read-only. This affects directory permissions for new downloads. It does not rewrite existing cache entries."
        },
