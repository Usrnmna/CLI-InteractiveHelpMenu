{
  "command": [
    "go",
    "mod",
    "tidy"
  ],
  "description": "Update go.mod and go.sum to match imports, including test dependencies.",
  "categories": [
    {
      "name": "Options",
      "description": "Module requirements, compatibility and change reporting.",
      "options": [
        {
          "flag": "-e",
          "argument": "",
          "argument_optional": false,
          "summary": "Continue despite package loading errors",
          "detail": "Tidy attempts the remaining work and can still change module files."
        },
        {
          "flag": "-v",
          "argument": "",
          "argument_optional": false,
          "summary": "List removed modules on stderr",
          "detail": "Write the names of removed modules to standard error."
        },
        {
          "flag": "-x",
          "argument": "",
          "argument_optional": false,
          "summary": "Show commands used for module downloads",
          "detail": "Downloads still take place when needed."
        },
        {
          "flag": "-diff",
          "argument": "",
          "argument_optional": false,
          "summary": "Preview changes to go.mod and go.sum",
          "detail": "Prints a unified diff and exits nonzero if edits are needed. Both files stay untouched. Requires Go 1.23 or newer. Ubuntu 24.04’s default Go 1.22 rejects this flag."
        },
        {
          "flag": "-go",
          "argument": "VERSION",
          "argument_optional": false,
          "summary": "Set the go directive in go.mod",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "identifier",
                "meaning": "Update the go.mod go directive to the given Go version",
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/golang/go/go1.24.0/src/cmd/go/alldocs.go",
                      "locator": "go mod tidy: -go purpose and default"
                    }
                  ]
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "Go"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "1.24.0"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "This parameter definition does not select an operating system; platform availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed"
                  }
                },
                "bare": {
                  "state": "not_applicable",
                  "reason": "A version string has a structured grammar, not a physical scale"
                },
                "forms": [
                  {
                    "id": "version",
                    "notation": "expression",
                    "syntax": "GO-VERSION",
                    "grammar": "A Go version string, not a floating-point measurement"
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "No explicit go-directive version override is supplied; module and Go release rules apply"
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "This option requires an operand"
                },
                "subject": "Go language/toolchain versions"
              }
            ]
          },
          "detail": "The version can change which indirect requirements tidy keeps for module graph pruning and lazy loading."
        },
        {
          "flag": "-compat",
          "argument": "VERSION",
          "argument_optional": false,
          "summary": "Check dependency resolution for a Go release",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "identifier",
                "meaning": "Preserve module-graph checksums and checks for the selected Go release",
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/golang/go/go1.24.0/src/cmd/go/alldocs.go",
                      "locator": "go mod tidy: explicit compatibility version and checksum policy"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/golang/go/go1.24.0/src/cmd/go/internal/modload/load.go",
                      "locator": "LoadPackages derives the effective TidyCompatibleVersion"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/golang/go/go1.24.0/src/cmd/go/internal/gover/version.go",
                      "locator": "GoStrictVersion is 1.21"
                    }
                  ]
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "Go"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "1.24.0"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "This parameter definition does not select an operating system; platform availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed"
                  }
                },
                "bare": {
                  "state": "not_applicable",
                  "reason": "A version string has a structured grammar, not a physical scale"
                },
                "forms": [
                  {
                    "id": "version",
                    "notation": "expression",
                    "syntax": "GO-VERSION",
                    "grammar": "A Go version string, not a floating-point measurement"
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Use the go directive for Go 1.21 and newer. For earlier directives use the preceding Go release."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "This option requires an operand"
                },
                "subject": "Go language/toolchain versions"
              }
            ]
          },
          "detail": "Keeps the checksums the selected release needs and reports imports that would resolve to a different module version. The default follows the go directive for Go 1.21 and newer and uses the previous release for older directives."
        }
      ]
    },
