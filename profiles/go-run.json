        {
          "argument": "MODE",
          "argument_optional": false,
          "flag": "-mod",
          "summary": "Choose how Go resolves module dependencies",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "enumeration",
                "meaning": "Go module access mode",
                "bare": {
                  "state": "not_applicable",
                  "reason": "This is a text/selector grammar, not an unsuffixed scalar measurement"
                },
                "forms": [
                  {
                    "id": "choice-1",
                    "notation": "literal",
                    "syntax": "readonly",
                    "tokens": [
                      "readonly"
                    ],
                    "case": "sensitive",
                    "meaning": "Disallow automatic go.mod changes required by module loading"
                  },
                  {
                    "id": "choice-2",
                    "notation": "literal",
                    "syntax": "vendor",
                    "tokens": [
                      "vendor"
                    ],
                    "case": "sensitive",
                    "meaning": "Use the vendor directory"
                  },
                  {
                    "id": "choice-3",
                    "notation": "literal",
                    "syntax": "mod",
                    "tokens": [
                      "mod"
                    ],
                    "case": "sensitive",
                    "meaning": "Permit module loading to update module files"
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Use Go's version/project-dependent automatic module mode, including automatic vendoring when applicable."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "Go"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
