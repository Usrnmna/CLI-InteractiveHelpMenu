                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/golang/go/go1.24.0/src/cmd/go/alldocs.go",
                      "locator": "build flags -mod"
                    }
                  ]
                }
              }
            ]
          },
          "detail": "readonly permits downloads but fails if go.mod needs edits. vendor reads vendored packages. mod permits module-file updates. A module declaring Go 1.14 or newer with a vendor directory normally uses vendor."
