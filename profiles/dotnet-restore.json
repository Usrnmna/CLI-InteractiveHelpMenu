          "summary": "Restore projects one at a time"
        },
        {
          "argument": "",
          "argument_optional": false,
          "flag": "--ignore-failed-sources",
          "summary": "Treat unavailable feeds as warnings when possible",
          "detail": "Restore still fails if the required package version cannot be found."
        },
        {
          "argument": "",
          "argument_optional": false,
          "flag": "--no-cache",
          "summary": "Bypass the NuGet HTTP cache",
          "detail": "Current help lists --no-http-cache. The SDK also accepts this older spelling. Restore can still reuse installed packages from the global packages folder."
        },
        {
          "argument": "",
          "argument_optional": false,
          "flag": "--force",
          "summary": "Resolve package dependencies again",
          "detail": "Repeats dependency resolution even after a successful restore, as if obj/project.assets.json had been removed."
        },
        {
          "argument": "",
          "argument_optional": false,
          "flag": "--locked-mode",
          "summary": "Fail if an existing dependency lock needs changes",
          "detail": "Generate packages.lock.json with --use-lock-file first. Locked mode alone does not enable lockfile generation."
        },
        {
          "argument": "",
          "argument_optional": false,
          "flag": "--use-lock-file",
          "summary": "Generate and use a dependency lockfile",
          "detail": "NuGet records the resolved graph in packages.lock.json. Use --locked-mode when changes to the lockfile must fail."
        },
