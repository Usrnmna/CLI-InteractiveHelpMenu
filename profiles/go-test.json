                    "id": "s",
                    "notation": "suffix",
                    "special_values": [
                      {
                        "meaning": "Disable the test timeout alarm",
                        "value": "0"
                      }
                    ],
                    "syntax": "Ns",
                    "tokens": [
                      "s"
                    ],
                    "unit": {
                      "base": "second",
                      "multiplier": "1"
                    }
                  },
                  {
                    "case": "sensitive",
                    "grammar": "Signed duration component; a nonpositive resolved duration disables the test timeout alarm in Go 1.24.0",
                    "id": "m",
                    "notation": "suffix",
                    "special_values": [
                      {
                        "meaning": "Disable the test timeout alarm",
                        "value": "0"
                      }
                    ],
                    "syntax": "Nm",
                    "tokens": [
                      "m"
                    ],
                    "unit": {
                      "base": "second",
                      "multiplier": "60"
