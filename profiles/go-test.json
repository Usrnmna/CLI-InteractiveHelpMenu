        {
          "argument": "DURATION",
          "argument_optional": false,
          "detail": "Go 1.24.0: the timeout is per test binary; the default is 10m. Use case-sensitive ns, us/µs/μs, ms, s, m or h, including combinations such as 1m30s. Bare nonzero numbers are not seconds and are rejected by duration parsing. Literal 0 and signed zero disable the timeout. The pinned testing implementation also disables the alarm for negative unit-bearing durations; that implementation behavior is not asserted for other releases.",
          "flag": "-timeout",
          "summary": "Set timeout with units, such as 30s; 0 disables",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "applicability": {
                  "chip": {
                    "reason": "No chip-specific interpretation is claimed",
                    "state": "not_applicable"
                  },
                  "implementation": {
                    "state": "known",
                    "values": [
                      "Go"
                    ]
                  },
                  "platform": {
                    "reason": "This parameter definition does not select an operating system; platform availability is not asserted",
                    "state": "not_applicable"
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "1.24.0"
                    ]
                  }
                },
                "bare": {
                  "reason": "Nonzero ordinary bare numbers require a unit; signed literal zero is the exception",
                  "state": "not_accepted"
                },
                "forms": [
                  {
                    "case": "sensitive",
                    "grammar": "Signed duration component; a nonpositive resolved duration disables the test timeout alarm in Go 1.24.0",
                    "id": "ns",
                    "notation": "suffix",
                    "special_values": [
                      {
                        "meaning": "Disable the test timeout alarm",
                        "value": "0"
                      }
                    ],
                    "syntax": "Nns",
                    "tokens": [
                      "ns"
                    ],
                    "unit": {
                      "base": "second",
                      "multiplier": "0.000000001"
                    }
                  },
                  {
                    "case": "sensitive",
                    "grammar": "Signed duration component; a nonpositive resolved duration disables the test timeout alarm in Go 1.24.0",
                    "id": "us",
                    "notation": "suffix",
                    "special_values": [
                      {
                        "meaning": "Disable the test timeout alarm",
                        "value": "0"
                      }
                    ],
                    "syntax": "Nus",
                    "tokens": [
                      "us",
                      "µs",
                      "μs"
                    ],
                    "unit": {
                      "base": "second",
                      "multiplier": "0.000001"
                    }
                  },
                  {
                    "case": "sensitive",
                    "grammar": "Signed duration component; a nonpositive resolved duration disables the test timeout alarm in Go 1.24.0",
                    "id": "ms",
                    "notation": "suffix",
                    "special_values": [
                      {
                        "meaning": "Disable the test timeout alarm",
                        "value": "0"
                      }
                    ],
                    "syntax": "Nms",
                    "tokens": [
                      "ms"
                    ],
                    "unit": {
                      "base": "second",
                      "multiplier": "0.001"
                    }
                  },
                  {
                    "case": "sensitive",
                    "grammar": "Signed duration component; a nonpositive resolved duration disables the test timeout alarm in Go 1.24.0",
                    "id": "s",
                    "notation": "suffix",
                    "special_values": [
                      {
                        "meaning": "Disable the test timeout alarm",
                        "value": "0"
                      }
                    ],
                    "syntax": "Ns",
                    "tokens": [
                      "s"
                    ],
                    "unit": {
                      "base": "second",
                      "multiplier": "1"
                    }
                  },
                  {
                    "case": "sensitive",
                    "grammar": "Signed duration component; a nonpositive resolved duration disables the test timeout alarm in Go 1.24.0",
                    "id": "m",
                    "notation": "suffix",
                    "special_values": [
                      {
                        "meaning": "Disable the test timeout alarm",
                        "value": "0"
                      }
                    ],
                    "syntax": "Nm",
                    "tokens": [
                      "m"
                    ],
                    "unit": {
                      "base": "second",
                      "multiplier": "60"
                    }
                  },
                  {
                    "case": "sensitive",
                    "grammar": "Signed duration component; a nonpositive resolved duration disables the test timeout alarm in Go 1.24.0",
                    "id": "h",
                    "notation": "suffix",
                    "special_values": [
                      {
                        "meaning": "Disable the test timeout alarm",
                        "value": "0"
                      }
                    ],
                    "syntax": "Nh",
                    "tokens": [
                      "h"
                    ],
                    "unit": {
                      "base": "second",
                      "multiplier": "3600"
                    }
                  },
                  {
                    "grammar": "Signed decimal components with unit suffixes; 1h30m is 5400 seconds; no d/day unit. Nonpositive totals disable the timeout alarm in Go 1.24.0",
                    "id": "compound",
                    "notation": "expression",
                    "syntax": "[+|-]NUMBERunit[NUMBERunit...]",
                    "unit": {
                      "base": "second",
                      "multiplier": "1"
                    }
                  },
                  {
                    "case": "sensitive",
                    "id": "disabled",
                    "meaning": "Disable the test timeout",
                    "notation": "literal",
                    "sentinel": true,
                    "syntax": "0 | +0 | -0",
                    "tokens": [
                      "0",
                      "+0",
                      "-0"
                    ]
                  }
                ],
                "kind": "duration",
                "meaning": "Maximum running time of a test binary",
                "review": {
                  "references": [
                    {
                      "locator": "test flag help for -count and -timeout",
                      "source": "https://raw.githubusercontent.com/golang/go/go1.24.0/src/cmd/go/internal/test/test.go"
                    },
                    {
                      "locator": "ParseDuration and unitMap",
                      "source": "https://raw.githubusercontent.com/golang/go/go1.24.0/src/time/format.go"
                    },
                    {
                      "locator": "M.startAlarm returns without an alarm when timeout <= 0",
                      "source": "https://raw.githubusercontent.com/golang/go/go1.24.0/src/testing/testing.go"
                    }
                  ],
                  "status": "verified"
                },
                "when_absent": {
                  "meaning": "The default timeout is 10m, or 600 seconds",
                  "state": "known"
                },
                "when_value_omitted": {
                  "reason": "This option requires an operand",
                  "state": "not_accepted"
                }
              }
            ]
          }
