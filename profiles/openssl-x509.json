        {
          "argument": "SECONDS",
          "detail": "Signed base-autodetected C integer in seconds, without unit suffix: decimal, 0x hexadecimal and leading-zero octal. Must fit ossl_intmax_t and time_t on the build. Negative intervals move the comparison into the past; zero checks expiry at the current instant. Very large offsets can exceed representable time and are not a portable interval. Reference scope: OpenSSL 3.0.16.",
          "flag": "-checkend",
          "summary": "Check certificate expiry within the next N seconds",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "duration",
                "meaning": "Certificate expiry comparison interval",
                "bare": {
                  "state": "accepted",
                  "form": "seconds"
                },
                "forms": [
                  {
                    "id": "seconds",
                    "notation": "number",
                    "syntax": "N",
                    "grammar": "Signed base-autodetected C integer in seconds, without unit suffix: decimal, 0x hexadecimal and leading-zero octal. Must fit ossl_intmax_t and time_t on the build. Negative intervals move the comparison into the past; zero checks expiry at the current instant. Very large offsets can exceed representable time and are not a portable interval.",
                    "unit": {
                      "base": "second",
                      "multiplier": "1"
                    },
                    "special_values": [
                      {
                        "value": "0",
                        "meaning": "Compare certificate expiry with the current instant"
                      }
                    ]
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Do not request the explicit checkend expiry test."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
