        {
          "argument": "",
          "flag": "-text",
          "summary": "Print the certificate fields in detail",
          "detail": "Includes names, public key, signature algorithms and extensions. Add -noout to display only the requested information."
        },
        {
          "argument": "",
          "flag": "-noout",
          "summary": "Omit encoded certificate output",
          "detail": "Requested fields still print. Use -noout -dates to see just the validity dates."
        },
        {
          "argument": "",
          "flag": "-subject",
          "summary": "Print the certificate subject name",
          "detail": "Use -noout to omit the encoded certificate. DNS names for hostname matching can appear in the subject alternative name extension."
        },
        {
          "argument": "",
          "flag": "-issuer",
          "summary": "Print the certificate issuer name",
          "detail": "This reads the issuer field. Establishing trust requires certificate verification."
        },
        {
          "argument": "",
          "flag": "-dates",
          "summary": "Print the start and expiry dates",
          "detail": "Shows both notBefore and notAfter. Use -checkend for a scriptable expiry check."
        },
        {
          "argument": "",
          "flag": "-fingerprint",
          "summary": "Print a digest of the entire certificate",
          "detail": "Hashes the DER encoding, so the same certificate has the same fingerprint in PEM or DER. The default is SHA-1. Add -sha256 to request SHA-256."
        },
        {
          "argument": "SECONDS",
          "detail": "For a readable certificate, exit status is nonzero if it expires by the cutoff and zero if its expiry is later. Use 0 to check expiry now. This tests the expiry time alone.",
          "flag": "-checkend",
          "summary": "Test whether the certificate expires within N seconds",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "duration",
                "meaning": "Certificate expiry comparison interval",
                "bare": {
                  "state": "accepted",
                  "form": "seconds"
                },
                "forms": [
                  {
                    "id": "seconds",
                    "notation": "number",
                    "syntax": "N",
                    "grammar": "Signed base-autodetected C integer in seconds, without unit suffix: decimal, 0x hexadecimal and leading-zero octal. Must fit ossl_intmax_t and time_t on the build. Negative intervals move the comparison into the past; zero checks expiry at the current instant. Very large offsets can exceed representable time and are not a portable interval.",
                    "unit": {
                      "base": "second",
                      "multiplier": "1"
                    },
                    "special_values": [
                      {
                        "value": "0",
                        "meaning": "Compare certificate expiry with the current instant"
                      }
                    ]
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Do not request the explicit checkend expiry test."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "OpenSSL"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "3.0.16"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/openssl/openssl/openssl-3.0.16/apps/x509.c",
                      "locator": "OPT_CHECKEND intmax parsing, time_t cast check and current-time offset"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/openssl/openssl/openssl-3.0.16/apps/lib/opt.c",
                      "locator": "opt_intmax base autodetection"
                    }
                  ]
                }
              }
            ]
          }
        }
