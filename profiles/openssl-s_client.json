        {
          "argument": "DEPTH",
          "detail": "Use a positive decimal depth for handling verification errors. To limit intermediate CAs, use -verify_depth N, which excludes the leaf and trust anchor. Add -verify_return_error to stop on errors.",
          "flag": "-verify",
          "summary": "Enable peer verification with a positive depth",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "count",
                "meaning": "Diagnostic peer verification depth",
                "bare": {
                  "state": "accepted",
                  "form": "count"
                },
                "forms": [
                  {
                    "id": "count",
                    "notation": "number",
                    "syntax": "N",
                    "grammar": "Use a positive decimal C int up to INT_MAX. Zero and negative inputs are rejected. On OpenSSL 3.0.16 the final conversion reads decimal digits, so hexadecimal and leading-zero forms do not reliably give the intended depth.",
                    "bounds": {
                      "min": "1"
                    }
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Do not enable peer verification through this option; other verification settings remain applicable."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
