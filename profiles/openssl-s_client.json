                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/openssl/openssl/openssl-3.0.16/apps/s_client.c",
                      "locator": "OPT_VERIFY option type p and assignment to verify_args.depth"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/openssl/openssl/openssl-3.0.16/apps/lib/opt.c",
                      "locator": "positive integer validation and OPT_V_VERIFY_DEPTH"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/openssl/openssl/openssl-3.0.16/apps/lib/s_cb.c",
                      "locator": "verify_callback compares depth when verification reports an error"
                    }
                  ]
                },
                "subject": "Depth of a certificate verification error"
              }
            ]
          }
        },
        {
          "argument": "",
          "flag": "-verify_return_error",
          "summary": "Stop the handshake on certificate verification errors",
          "detail": "Enables peer verification. Add -verify_hostname NAME when the server certificate must match a particular DNS name."
        },
