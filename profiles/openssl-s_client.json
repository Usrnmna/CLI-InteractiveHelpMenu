                "kind": "count",
                "meaning": "Positive certificate verification depth",
                "bare": {
                  "state": "accepted",
                  "form": "count"
                },
                "forms": [
                  {
                    "id": "count",
                    "notation": "number",
                    "syntax": "N",
                    "grammar": "Positive C int, with base-autodetected decimal, 0x hexadecimal or leading-zero octal spelling. Zero and negatives are rejected by this option's 'p' parser; the upper bound is the build's INT_MAX. A depth of N permits up to N intermediate CAs, plus leaf and trust anchor.",
                    "bounds": {
                      "min": "1"
                    }
                  }
                ],
                "when_absent": {
