  "stop_at_positional": false,
  "value_definitions": {
    "compile-jobs": {
      "kind": "count",
      "meaning": "Parallel compilation worker limit",
      "bare": {
        "state": "accepted",
        "form": "count"
      },
      "forms": [
        {
          "id": "count",
          "notation": "number",
          "syntax": "N",
          "grammar": "Signed 32-bit CLI integer, without suffix. Zero selects runtime.NumCPU(). Positive values start that many workers. Negative inputs are admitted by the signed parser but start no workers and can stall compilation; they are not a usable worker limit.",
          "bounds": {
            "min": "-2147483648",
            "max": "2147483647"
          },
          "special_values": [
            {
              "value": "0",
              "meaning": "Use the number of available CPU cores"
            }
          ]
        }
      ],
      "when_absent": {
        "state": "known",
        "meaning": "Use 0, selecting the available CPU-core count."
      },
      "when_value_omitted": {
        "state": "not_accepted",
        "reason": "The option requires its operand"
      },
      "applicability": {
        "implementation": {
          "state": "known",
          "values": [
            "Arduino CLI"
          ]
        },
        "version": {
          "state": "known",
          "values": [
            "1.2.2"
          ]
        },
        "platform": {
          "state": "not_applicable",
          "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
        },
        "chip": {
          "state": "not_applicable",
          "reason": "No chip-specific interpretation is claimed by this parameter contract"
        }
      },
      "review": {
        "status": "verified",
        "references": [
          {
            "source": "https://raw.githubusercontent.com/arduino/arduino-cli/v1.2.2/internal/cli/compile/compile.go",
            "locator": "Int32VarP jobs, default 0"
          },
          {
            "source": "https://raw.githubusercontent.com/arduino/arduino-cli/v1.2.2/internal/arduino/builder/compilation.go",
            "locator": "compileFiles worker loop and zero handling"
          }
        ]
      },
      "subject": "Concurrent Arduino compilation workers"
    }
  }
