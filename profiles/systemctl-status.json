{
  "categories": [
    {
      "description": "Unit selection, status reports and journal excerpts.",
      "name": "Arguments",
      "options": [
        {
          "argument": "",
          "flag": "--user",
          "summary": "Use the current user’s service manager",
          "detail": "Selects units managed for the calling user."
        },
        {
          "argument": "",
          "flag": "--system",
          "summary": "Use the system service manager",
          "detail": "This is the default manager."
        },
        {
          "argument": "",
          "flag": "--no-pager",
          "summary": "Write output without a pager"
        },
        {
          "argument": "",
          "flag": "--no-legend",
          "summary": "Applies to table legends only",
          "detail": "The status report has no table legend. Its unit heading and journal excerpt remain visible."
        },
        {
          "argument": "",
          "flag": "--full",
          "summary": "Show status text at full width",
          "detail": "Preserve long unit names, descriptions, process tree entries and journal messages."
        },
        {
          "argument": "",
          "flag": "--all",
          "summary": "Show status for all units in memory",
          "detail": "With no operands or unit filters, print the manager overview followed by unit reports. A named unit still selects that unit."
        },
        {
          "argument": "TYPE",
          "flag": "--type=",
          "summary": "Show status for matching unit types",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "enumeration",
                "meaning": "systemd unit types",
                "bare": {
                  "state": "not_applicable",
                  "reason": "This is a text/selector grammar, not an unsuffixed scalar measurement"
                },
                "forms": [
                  {
                    "id": "text",
                    "notation": "expression",
                    "syntax": "VALUE",
                    "grammar": "Comma-separated unit-type names such as service, socket, target, timer, device, mount, automount, swap, path, slice and scope; help requests the supported type list."
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Do not add a unit-type filter."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "systemd"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "257"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/systemd/systemd/v257/man/systemctl.xml",
                      "locator": "--type"
                    }
                  ]
                }
              }
            ]
          },
          "detail": "With no operand or a unit glob, select types such as service,timer. An explicit unit name is looked up directly. Ubuntu 24.04 and 26.04 require a value after =."
        },
        {
          "argument": "STATE",
          "flag": "--state=",
          "summary": "Show status for units in selected states",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "enumeration",
                "meaning": "systemd unit state names",
                "bare": {
                  "state": "not_applicable",
                  "reason": "This is a text/selector grammar, not an unsuffixed scalar measurement"
                },
                "forms": [
                  {
                    "id": "text",
                    "notation": "expression",
                    "syntax": "VALUE",
                    "grammar": "Comma-separated load, active or substate names, such as loaded, active, inactive, failed or running; meanings and available substates depend on unit type. help requests the state-name list."
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Use the selected subcommand's normal state filtering."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "systemd"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "257"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/systemd/systemd/v257/man/systemctl.xml",
                      "locator": "--state"
                    }
                  ]
                }
              }
            ]
          },
          "detail": "Use --state=failed without a unit name to inspect failed units. Explicit unit names bypass this filter. Ubuntu 24.04 and 26.04 require a value after =."
        },
        {
          "argument": "",
          "flag": "--plain",
          "summary": "Applies to listing symbols only",
          "detail": "The unit status heading and process tree keep their usual formatting."
        },
        {
          "argument": "LINES",
          "detail": "The default is 10 per unit. Use --lines=0 to hide the journal excerpt while keeping the status report.",
          "flag": "--lines=",
          "summary": "Set the number of recent journal entries",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "applicability": {
                  "chip": {
                    "reason": "No chip-specific interpretation is claimed",
                    "state": "not_applicable"
                  },
                  "implementation": {
                    "state": "known",
                    "values": [
                      "systemd"
                    ]
                  },
                  "platform": {
                    "state": "known",
                    "values": [
                      "Linux"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "257"
                    ]
                  }
                },
                "bare": {
                  "form": "lines",
                  "state": "accepted"
                },
                "forms": [
                  {
                    "bounds": {
                      "min": "0"
                    },
                    "grammar": "Decimal integer journal-line count",
                    "id": "lines",
                    "notation": "number",
                    "special_values": [
                      {
                        "meaning": "Suppress the status journal output",
                        "value": "0"
                      }
                    ],
                    "syntax": "N"
                  }
                ],
                "kind": "count",
                "meaning": "Journal lines included in systemctl status output",
                "review": {
                  "references": [
                    {
                      "locator": "--lines applies to status; zero disables journal output; default 10",
                      "source": "https://www.freedesktop.org/software/systemd/man/257/systemctl.html"
                    }
                  ],
                  "status": "verified"
                },
                "subject": "Recent journal lines for status output",
                "when_absent": {
                  "form": "lines",
                  "state": "known",
                  "value": "10"
                },
                "when_value_omitted": {
                  "reason": "This option requires an operand",
                  "state": "not_accepted"
                }
              }
            ]
          }
        },
        {
          "argument": "FORMAT",
          "flag": "--output=",
          "summary": "Choose the format of the journal excerpt",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "enumeration",
                "meaning": "Status journal output representation",
                "bare": {
                  "state": "not_applicable",
                  "reason": "This is a text/selector grammar, not an unsuffixed scalar measurement"
                },
                "forms": [
                  {
                    "id": "choice-1",
                    "notation": "literal",
                    "syntax": "short",
                    "tokens": [
                      "short"
                    ],
                    "case": "sensitive",
                    "meaning": "Classic syslog-style output"
                  },
                  {
                    "id": "choice-2",
                    "notation": "literal",
                    "syntax": "short-full",
                    "tokens": [
                      "short-full"
                    ],
                    "case": "sensitive",
                    "meaning": "Short output with complete timestamp"
                  },
                  {
                    "id": "choice-3",
                    "notation": "literal",
                    "syntax": "short-iso",
                    "tokens": [
                      "short-iso"
                    ],
                    "case": "sensitive",
                    "meaning": "ISO-style timestamps"
                  },
                  {
                    "id": "choice-4",
                    "notation": "literal",
                    "syntax": "short-iso-precise",
                    "tokens": [
                      "short-iso-precise"
                    ],
                    "case": "sensitive",
                    "meaning": "ISO timestamps with microsecond precision"
                  },
                  {
                    "id": "choice-5",
                    "notation": "literal",
                    "syntax": "short-precise",
                    "tokens": [
                      "short-precise"
                    ],
                    "case": "sensitive",
                    "meaning": "Short output with microsecond timestamps"
                  },
                  {
                    "id": "choice-6",
                    "notation": "literal",
                    "syntax": "short-monotonic",
                    "tokens": [
                      "short-monotonic"
                    ],
                    "case": "sensitive",
                    "meaning": "Monotonic timestamps"
                  },
                  {
                    "id": "short-delta",
                    "notation": "literal",
                    "syntax": "short-delta",
                    "tokens": [
                      "short-delta"
                    ],
                    "case": "sensitive",
                    "meaning": "Monotonic timestamps with time since the preceding entry"
                  },
                  {
                    "id": "choice-7",
                    "notation": "literal",
                    "syntax": "short-unix",
                    "tokens": [
                      "short-unix"
                    ],
                    "case": "sensitive",
                    "meaning": "Epoch-second timestamps"
                  },
                  {
                    "id": "choice-8",
                    "notation": "literal",
                    "syntax": "verbose",
                    "tokens": [
                      "verbose"
                    ],
                    "case": "sensitive",
                    "meaning": "All journal fields"
                  },
                  {
                    "id": "choice-9",
                    "notation": "literal",
                    "syntax": "export",
                    "tokens": [
                      "export"
                    ],
                    "case": "sensitive",
                    "meaning": "Journal export serialization"
                  },
                  {
                    "id": "choice-10",
                    "notation": "literal",
                    "syntax": "json",
                    "tokens": [
                      "json"
                    ],
                    "case": "sensitive",
                    "meaning": "JSON records"
                  },
                  {
                    "id": "choice-11",
                    "notation": "literal",
                    "syntax": "json-pretty",
                    "tokens": [
                      "json-pretty"
                    ],
                    "case": "sensitive",
                    "meaning": "Indented JSON"
                  },
                  {
                    "id": "choice-12",
                    "notation": "literal",
                    "syntax": "json-sse",
                    "tokens": [
                      "json-sse"
                    ],
                    "case": "sensitive",
                    "meaning": "Server-sent-event JSON"
                  },
                  {
                    "id": "choice-13",
                    "notation": "literal",
                    "syntax": "json-seq",
                    "tokens": [
                      "json-seq"
                    ],
                    "case": "sensitive",
                    "meaning": "JSON text sequences"
                  },
                  {
                    "id": "choice-14",
                    "notation": "literal",
                    "syntax": "cat",
                    "tokens": [
                      "cat"
                    ],
                    "case": "sensitive",
                    "meaning": "Message text only"
                  },
                  {
                    "id": "choice-15",
                    "notation": "literal",
                    "syntax": "with-unit",
                    "tokens": [
                      "with-unit"
                    ],
                    "case": "sensitive",
                    "meaning": "Short output including unit identity"
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Use short journal output where the command displays journal lines; other output is unaffected."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "systemd"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "257"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/systemd/systemd/v257/man/journalctl.xml",
                      "locator": "Output modes, including short-delta"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/systemd/systemd/v257/man/systemctl.xml",
                      "locator": "--output= and status"
                    }
                  ]
                }
              }
            ]
          },
          "detail": "The default is short. Use cat for message text or json for structured entries. The status heading keeps its usual format."
        }
      ]
    }
  ],
  "command": [
    "systemctl",
    "status"
  ],
  "description": "Show runtime status for the manager, a unit or the unit containing a PID."
}
