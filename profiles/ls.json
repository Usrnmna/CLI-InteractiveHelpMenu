    {
      "description": "Control ordering of directory entries.",
      "name": "Sorting",
      "options": [
        {
          "detail": "With -t, oldest comes first. With -S, smallest comes first. Has no effect with -U (unsorted).",
          "flag": "--reverse",
          "summary": "Reverse the sorting order"
        },
        {
          "detail": "Use --time to choose another timestamp, such as access time with --time=atime.",
          "flag": "-t",
          "summary": "Sort by modification time, newest first"
        },
        {
          "flag": "-S",
          "summary": "Sort by file length, largest first"
        },
        {
          "detail": "Sort each group separately using the selected sort order. -U disables grouping.",
          "flag": "--group-directories-first",
          "summary": "List directories before files"
        }
      ]
    },
    {
      "description": "Control directory and symbolic-link handling.",
      "name": "Traversal",
      "options": [
        {
          "detail": "List the contents of each directory and its subdirectories. Links encountered during descent are normally listed as links. Add -L to follow them.",
          "flag": "--recursive",
          "summary": "List subdirectories recursively"
        },
        {
          "detail": "Use -ld DIR to show the directory's own long listing. For a symbolic link to a directory, -ld shows the link and -ldL shows the target directory under the link name.",
          "flag": "--directory",
          "summary": "List directories themselves"
        },
        {
          "detail": "Keep the link name but use the target's attributes. Applies to named and discovered links. A plain ls of a named link to a directory normally lists its contents. Use -H to follow only command-line links.",
          "flag": "--dereference",
          "summary": "Show information for symbolic-link targets"
        }
      ]
    }
  ],
  "command": [
    "ls"
  ],
  "description": "List files and directory contents using GNU ls options."
