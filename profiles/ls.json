      "description": "Control visible files and output formatting.",
      "name": "Display",
      "options": [
        {
          "detail": "When listing a directory, include the implied . (this directory) and .. (its parent).",
          "flag": "--all",
          "summary": "Include entries beginning with a dot"
        },
        {
          "detail": "Skip only the implied . and .. in directory listings. An explicitly named hidden file is still listed.",
          "flag": "--almost-all",
          "summary": "Include hidden names except the . and .. entries"
        },
        {
          "detail": "Show type and permissions, link count, owner, group, file length, modification time (by default) and name. Length normally uses bytes. -h, --block-size, LS_BLOCK_SIZE or BLOCK_SIZE can scale it. Device files show major and minor numbers in the size field.",
          "flag": "-l",
          "summary": "Use the long listing format"
        },
