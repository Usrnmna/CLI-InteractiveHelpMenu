        {
          "flag": "--line-length",
          "argument": "LENGTH",
          "argument_optional": false,
          "summary": "Set preferred line width using Unicode character widths",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "quantity",
                "meaning": "Preferred formatted line width",
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/astral-sh/ruff/0.11.13/crates/ruff_workspace/src/options.rs",
                      "locator": "Options.line_length: Unicode width, 1-320, default 88"
                    }
                  ]
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "Ruff"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "0.11.13"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "This parameter definition does not select an operating system; platform availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed"
                  }
                },
                "bare": {
                  "state": "accepted",
                  "form": "width"
                },
                "forms": [
                  {
                    "id": "width",
                    "notation": "number",
                    "syntax": "N",
                    "unit": {
                      "base": "custom",
                      "multiplier": "1",
                      "name": "Ruff width units",
                      "definition": "Characters normally count as one; East Asian characters and emoji use Unicode display width"
                    },
                    "bounds": {
                      "min": "1",
                      "max": "320"
                    }
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Use configured line-length, default 88 in this reference"
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "This option requires an operand"
                }
              }
            ]
          },
          "detail": "Ruff 0.11.13: LENGTH is an integer from 1 through 320; the default is 88 unless configured. Most characters count as one, while East Asian characters and emoji use Unicode width. This is not a UTF-8 byte count. The formatter treats it as a preferred width, not a hard upper bound."
        },
        {
          "flag": "--target-version",
          "argument": "VERSION",
          "argument_optional": false,
          "summary": "Select Python target version",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "identifier",
                "meaning": "Minimum Python language version targeted by Ruff",
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/astral-sh/ruff/0.11.13/crates/ruff_workspace/src/options.rs",
                      "locator": "target_version setting, accepted py37-py313 values, py39 default and project inference"
                    }
                  ]
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "Ruff"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "0.11.13"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "This parameter definition does not select an operating system; platform availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed"
                  }
                },
                "bare": {
                  "state": "not_accepted",
                  "reason": "Use one of the literal py-prefixed release identifiers"
                },
                "forms": [
                  {
                    "id": "python-version",
                    "notation": "literal",
                    "syntax": "py37 | py38 | py39 | py310 | py311 | py312 | py313",
                    "tokens": [
                      "py37",
                      "py38",
                      "py39",
                      "py310",
                      "py311",
                      "py312",
                      "py313"
                    ],
                    "case": "sensitive",
                    "meaning": "Python 3.7 through 3.13 release identifiers; py310 means Python 3.10, not a scaled number"
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Use configuration/project-version inference; the documented setting default is py39"
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "This option requires an operand"
                },
                "subject": "Python language versions"
              }
            ]
          },
          "detail": "Ruff 0.11.13: use the literal Python release IDs py37, py38, py39, py310, py311, py312 or py313. For example, py310 identifies Python 3.10; it is not a decimal value or physical quantity. Without this override, configuration/project inference applies; the documented setting default is py39."
        },
