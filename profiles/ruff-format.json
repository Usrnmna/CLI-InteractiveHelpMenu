                  "version": {
                    "state": "known",
                    "values": [
                      "0.11.13"
                    ]
                  }
                },
                "bare": {
                  "reason": "Use one of the literal py-prefixed release identifiers",
                  "state": "not_accepted"
                },
                "forms": [
                  {
                    "case": "sensitive",
                    "id": "python-version",
                    "meaning": "Python 3.7 through 3.13 release identifiers; py310 means Python 3.10, not a scaled number",
                    "notation": "literal",
                    "syntax": "py37 | py38 | py39 | py310 | py311 | py312 | py313",
                    "tokens": [
                      "py37",
                      "py38",
                      "py39",
                      "py310",
