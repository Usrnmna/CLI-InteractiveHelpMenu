                    "state": "not_applicable"
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "0.11.13"
                    ]
                  }
                },
                "bare": {
                  "form": "width",
                  "state": "accepted"
                },
                "forms": [
                  {
                    "bounds": {
                      "max": "320",
                      "min": "1"
                    },
                    "id": "width",
                    "notation": "number",
                    "syntax": "N",
                    "unit": {
                      "base": "custom",
                      "definition": "Characters normally count as one; East Asian characters and emoji use Unicode display width",
                      "multiplier": "1",
                      "name": "Ruff width units"
                    }
                  }
                ],
                "kind": "quantity",
                "meaning": "Preferred formatted line width",
                "review": {
                  "references": [
                    {
                      "locator": "Options.line_length: Unicode width, 1-320, default 88",
                      "source": "https://raw.githubusercontent.com/astral-sh/ruff/0.11.13/crates/ruff_workspace/src/options.rs"
                    }
                  ],
                  "status": "verified"
                },
                "when_absent": {
                  "meaning": "Use configured line-length, default 88 in this reference",
                  "state": "known"
                },
                "when_value_omitted": {
                  "reason": "This option requires an operand",
                  "state": "not_accepted"
                }
              }
            ]
          }
        },
        {
          "argument": "VERSION",
          "argument_optional": false,
          "detail": "Ruff 0.11.13: use the literal Python release IDs py37, py38, py39, py310, py311, py312 or py313. For example, py310 identifies Python 3.10; it is not a decimal value or physical quantity. Without this override, configuration/project inference applies; the documented setting default is py39.",
          "flag": "--target-version",
          "summary": "Select Python target version",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "applicability": {
                  "chip": {
