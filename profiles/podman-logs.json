                "forms": [
                  {
                    "id": "lines",
                    "notation": "number",
                    "syntax": "N",
                    "bounds": {
                      "min": "0"
                    },
                    "special_values": [
                      {
                        "value": "-1",
                        "meaning": "Display all log lines"
                      }
                    ],
                    "grammar": "Integer line count; -1 is the all-lines sentinel"
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "form": "lines",
                  "value": "-1"
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "This option requires an operand"
                },
                "subject": "Container log lines"
              }
            ]
          },
          "detail": "Podman 5.4.2: LINES counts trailing log lines. The default -1 prints all lines; it is a sentinel, not a negative duration or byte count."
