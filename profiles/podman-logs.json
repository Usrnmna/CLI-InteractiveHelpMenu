          "argument": "LINES",
          "summary": "Select the number of trailing lines",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "count",
                "meaning": "Trailing log lines displayed",
                "review": {
                  "status": "verified",
