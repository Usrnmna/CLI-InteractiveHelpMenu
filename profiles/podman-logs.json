{
  "command": [
    "podman",
    "logs"
  ],
  "description": "Read recorded output from one or more containers.",
  "categories": [
    {
      "name": "Arguments",
      "description": "Log lines, time filters and container labels.",
      "options": [
        {
          "flag": "--follow",
          "argument": "",
          "summary": "Keep reading new log output",
          "detail": "A container removed on exit with --rm can lose its log file before Podman reads the last lines."
        },
        {
          "flag": "-f",
          "argument": "",
          "summary": "Keep reading new log output",
          "detail": "A container removed on exit with --rm can lose its log file before Podman reads the last lines."
        },
        {
          "flag": "--timestamps",
          "argument": "",
          "summary": "Show a timestamp on each log line"
        },
        {
          "flag": "--tail",
          "argument": "LINES",
          "summary": "Show the last N log lines",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "count",
                "meaning": "Trailing log lines displayed",
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://docs.podman.io/en/v5.4.2/markdown/podman-logs.1.html",
                      "locator": "--tail, --since and --until"
                    }
                  ]
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "Podman"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "5.4.2"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "This parameter definition does not select an operating system; platform availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed"
                  }
                },
                "bare": {
                  "state": "accepted",
                  "form": "lines"
                },
                "forms": [
                  {
                    "id": "lines",
                    "notation": "number",
                    "syntax": "N",
                    "bounds": {
                      "min": "0"
                    },
                    "special_values": [
                      {
                        "value": "-1",
                        "meaning": "Display all log lines"
                      }
                    ],
                    "grammar": "Integer line count; -1 is the all-lines sentinel"
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "form": "lines",
                  "value": "-1"
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "This option requires an operand"
                },
                "subject": "Container log lines"
              }
            ]
          },
          "detail": "Use an integer line count. The default, -1, shows all lines."
        },
        {
          "flag": "--since",
          "argument": "TIME",
          "summary": "Show logs starting at a time",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "timestamp",
                "meaning": "Container log time cutoff",
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://docs.podman.io/en/v5.4.2/markdown/podman-logs.1.html",
                      "locator": "--tail, --since and --until"
                    },
                    {
                      "source": "https://github.com/containers/podman/blob/v5.4.2/pkg/util/utils.go",
                      "locator": "ParseInputTime duration direction"
                    }
                  ]
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "Podman"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "5.4.2"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "This parameter definition does not select an operating system; platform availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed"
                  }
                },
                "bare": {
                  "state": "accepted",
                  "form": "epoch"
                },
                "forms": [
                  {
                    "id": "epoch",
                    "notation": "number",
                    "syntax": "N",
                    "unit": {
                      "base": "second",
                      "multiplier": "1"
                    },
                    "grammar": "Unix timestamp in seconds, not milliseconds"
                  },
                  {
                    "id": "calendar",
                    "notation": "expression",
                    "syntax": "RFC3339[.nanoseconds] | documented calendar form",
                    "grammar": "Use a documented date/time form; quote values containing spaces"
                  },
                  {
                    "id": "relative",
                    "notation": "expression",
                    "syntax": "Go-duration",
                    "grammar": "A positive Go duration counts backward from the client clock."
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "No explicit lower log-time cutoff is added"
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "This option requires an operand"
                },
                "time_basis": "Unix timestamps count seconds from the epoch. Dates without a zone use UTC. Relative durations use the client clock."
              }
            ]
          },
          "detail": "Use Unix seconds, a date such as 2026-01-01, or an RFC3339 timestamp. Use --since 10m to start ten minutes before the client’s current time."
        },
        {
          "flag": "--until",
          "argument": "TIME",
          "summary": "Show logs up to a cutoff time",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "timestamp",
                "meaning": "Container log time cutoff",
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://docs.podman.io/en/v5.4.2/markdown/podman-logs.1.html",
                      "locator": "--tail, --since and --until"
                    },
                    {
                      "source": "https://github.com/containers/podman/blob/v5.4.2/pkg/util/utils.go",
                      "locator": "ParseInputTime duration direction"
                    }
                  ]
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "Podman"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "5.4.2"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "This parameter definition does not select an operating system; platform availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed"
                  }
                },
                "bare": {
                  "state": "accepted",
                  "form": "epoch"
                },
                "forms": [
                  {
                    "id": "epoch",
                    "notation": "number",
                    "syntax": "N",
                    "unit": {
                      "base": "second",
                      "multiplier": "1"
                    },
                    "grammar": "Unix timestamp in seconds, not milliseconds"
                  },
                  {
                    "id": "calendar",
                    "notation": "expression",
                    "syntax": "RFC3339[.nanoseconds] | documented calendar form",
                    "grammar": "Use a documented date/time form; quote values containing spaces"
                  },
                  {
                    "id": "relative",
                    "notation": "expression",
                    "syntax": "Go-duration",
                    "grammar": "A positive Go duration counts forward from the client clock."
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "No explicit upper log-time cutoff is added"
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "This option requires an operand"
                },
                "time_basis": "Unix timestamps count seconds from the epoch. Dates without a zone use UTC. Relative durations use the client clock."
              }
            ]
          },
          "detail": "Give a Unix time in seconds, a date, or an RFC3339 timestamp. Use --until 10m to set a cutoff ten minutes after the client’s current time. Use --until=-10m for ten minutes ago."
        },
        {
          "flag": "--names",
          "argument": "",
          "summary": "Label multiple containers by name",
          "detail": "Uses each container’s name in place of its ID in the log prefix."
        },
        {
          "flag": "--color",
          "argument": "",
          "summary": "Give each container a different log color"
        }
      ]
    }
  ]
}
