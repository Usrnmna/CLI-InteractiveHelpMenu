        {
          "argument": "NUMBER",
          "detail": "Integer space count, without unit suffix. Positive values select that many spaces. YAML zero uses the pinned yaml.v3 encoder's four-space default and negative values are rejected by SetIndent. JSON and XML nonpositive values build an empty indentation string; this does not promise one-line XML or remove string/document content. The CLI sets this preference only for YAML/JSON/XML; other encoders do not acquire an indentation unit or rule from it. Reference scope: mikefarah/yq 4.44.3.",
          "flag": "--indent",
          "summary": "Set indentation spaces; zero depends on output encoder",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "count",
                "meaning": "Encoder-specific output indentation",
                "bare": {
                  "state": "accepted",
                  "form": "count"
                },
                "forms": [
                  {
                    "id": "count",
                    "notation": "number",
                    "syntax": "N",
                    "grammar": "Integer space count, without unit suffix. Positive values select that many spaces. YAML zero uses the pinned yaml.v3 encoder's four-space default and negative values are rejected by SetIndent. JSON and XML nonpositive values build an empty indentation string; this does not promise one-line XML or remove string/document content. The CLI sets this preference only for YAML/JSON/XML; other encoders do not acquire an indentation unit or rule from it.",
                    "special_values": [
                      {
                        "value": "0",
                        "meaning": "YAML uses four spaces; JSON/XML use no indentation spaces; this is encoder-specific"
                      }
                    ]
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Use 2 spaces for the applicable encoder."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "mikefarah/yq"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "4.44.3"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/mikefarah/yq/v4.44.3/cmd/root.go",
                      "locator": "--indent IntVar default 2"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/mikefarah/yq/v4.44.3/cmd/utils.go",
                      "locator": "configureEncoder assigns Indent only to XML/YAML/JSON preferences"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/mikefarah/yq/v4.44.3/pkg/yqlib/encoder_json.go",
                      "locator": "NewJSONEncoder positive-space loop"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/mikefarah/yq/v4.44.3/pkg/yqlib/encoder_xml.go",
                      "locator": "NewXMLEncoder positive-space loop"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/mikefarah/yq/v4.44.3/pkg/yqlib/encoder_yaml.go",
                      "locator": "YamlEncoder passes preference to yaml.Encoder.SetIndent"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/mikefarah/yq/v4.44.3/go.mod",
                      "locator": "yaml.v3 v3.0.1 dependency"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/go-yaml/yaml/v3.0.1/yaml.go",
                      "locator": "SetIndent rejects negative values"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/go-yaml/yaml/v3.0.1/encode.go",
                      "locator": "encoder.init maps zero to 4"
                    }
                  ]
                },
                "subject": "Spaces per indentation level in YAML, JSON or XML output"
              }
            ]
          }
