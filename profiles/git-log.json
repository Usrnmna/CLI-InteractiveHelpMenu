                      "Git"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "2.48.0"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/git/git/v2.48.0/Documentation/rev-list-options.txt",
                      "locator": "--author"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "argument": "PATTERN",
          "flag": "--grep=",
          "summary": "Filter commit messages",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "nonnumerical",
                "meaning": "Commit-message matching expression",
                "bare": {
                  "state": "not_applicable",
                  "reason": "This is a text/selector grammar, not an unsuffixed scalar measurement"
                },
                "forms": [
                  {
                    "id": "text",
                    "notation": "expression",
                    "syntax": "VALUE",
                    "grammar": "Regular expression matching commit/stash messages; multiple patterns and selected regexp modes follow Git log rules."
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Do not add a message-pattern restriction."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
