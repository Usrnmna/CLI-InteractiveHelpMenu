          "summary": "Show each commit's patch"
        }
      ]
    },
    {
      "description": "Select the commits shown.",
      "name": "Filtering",
      "options": [
        {
          "argument": "COUNT",
          "detail": "Git 2.48.0: the value is a maximum output count, not seconds or bytes. Other filters still apply. Zero selects no entries; omitting this option imposes no count limit.",
          "flag": "--max-count=",
          "summary": "Limit the number of commits",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "ref": "output-count"
              }
            ]
          }
        },
        {
          "argument": "PATTERN",
          "flag": "--author=",
          "summary": "Filter by author",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "nonnumerical",
                "meaning": "Author matching expression",
                "bare": {
                  "state": "not_applicable",
                  "reason": "This is a text/selector grammar, not an unsuffixed scalar measurement"
                },
                "forms": [
                  {
                    "id": "text",
                    "notation": "expression",
                    "syntax": "VALUE",
                    "grammar": "Regular expression matching author headers; multiple author patterns and selected regexp modes follow git-log rules. Numerical text is a pattern, not an author count."
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Do not restrict commits by an explicit author pattern."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
