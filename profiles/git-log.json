                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/git/git/v2.48.0/Documentation/rev-list-options.txt",
                      "locator": "--grep"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "argument": "DATE",
          "detail": "Git 2.48.0 date grammar accepts calendar/ISO/RFC-style times, explicit epoch-second raw dates with timezone, and relative expressions such as '2 weeks ago'. Unzoned calendar values use local time; relative values use the current wall clock. Bare numerals are heuristic: values >=100000000 can be treated as epoch seconds while smaller values can be calendar fields; they are not uniformly seconds or milliseconds. Use an explicit unambiguous date/expression. Reference scope: Git 2.48.0.",
          "flag": "--since=",
          "summary": "Filter by a Git date/time expression",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "timestamp",
                "meaning": "Commit date lower-bound expression",
                "bare": {
                  "state": "not_applicable",
                  "reason": "Bare numbers use Git's calendar/epoch heuristics, not one scalar duration unit; the form documents the threshold and explicit alternatives"
                },
                "forms": [
                  {
                    "id": "text",
                    "notation": "expression",
                    "syntax": "VALUE",
                    "grammar": "Git 2.48.0 date grammar accepts calendar/ISO/RFC-style times, explicit epoch-second raw dates with timezone, and relative expressions such as '2 weeks ago'. Unzoned calendar values use local time; relative values use the current wall clock. Bare numerals are heuristic: values >=100000000 can be treated as epoch seconds while smaller values can be calendar fields; they are not uniformly seconds or milliseconds. Use an explicit unambiguous date/expression."
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Do not add a since cutoff."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "Git"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "2.48.0"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/git/git/v2.48.0/date.c",
                      "locator": "parse_date_basic, match_digit >=100000000, approxidate_careful"
                    },
                    {
                      "source": "https://raw.githubusercontent.com/git/git/v2.48.0/Documentation/rev-list-options.txt",
                      "locator": "--since date"
                    }
                  ]
                },
                "time_basis": "Absolute times are epoch-second instants with parsed timezone; unzoned dates/relative expressions use local wall-clock context."
              }
            ]
          }
        },
        {
          "flag": "--all",
          "summary": "Include all references"
        }
      ]
    }
  ],
  "command": [
    "git",
    "log"
  ],
  "description": "Inspect Git commit history.",
  "value_definitions": {
    "output-count": {
      "applicability": {
        "chip": {
          "reason": "No chip-specific interpretation is claimed",
          "state": "not_applicable"
        },
        "implementation": {
          "state": "known",
          "values": [
            "Git"
          ]
        },
        "platform": {
          "reason": "This parameter definition does not select an operating system; platform availability is not asserted",
          "state": "not_applicable"
        },
        "version": {
          "state": "known",
          "values": [
            "2.48.0"
          ]
        }
      },
      "bare": {
        "form": "entries",
        "state": "accepted"
      },
      "forms": [
        {
          "bounds": {
            "min": "0"
          },
          "grammar": "Nonnegative integer output count",
          "id": "entries",
          "notation": "number",
          "special_values": [
            {
              "meaning": "Display no selected entries",
              "value": "0"
            }
          ],
          "syntax": "N"
        }
      ],
      "kind": "count",
      "meaning": "Maximum number of commits displayed",
      "review": {
        "references": [
          {
            "locator": "Commit limiting: --max-count and --since",
            "source": "https://git-scm.com/docs/git-log/2.48.0"
          }
        ],
        "status": "verified"
      },
      "subject": "Commits",
      "when_absent": {
        "meaning": "No explicit maximum output count is imposed",
        "state": "known"
      },
      "when_value_omitted": {
        "reason": "This option requires an operand",
        "state": "not_accepted"
      }
    }
  }
