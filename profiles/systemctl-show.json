                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Use the selected subcommand's normal state filtering."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "systemd"
