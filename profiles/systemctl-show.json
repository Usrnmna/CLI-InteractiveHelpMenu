{
  "categories": [
    {
      "description": "Manager selection and property output.",
      "name": "Arguments",
      "options": [
        {
          "argument": "",
          "flag": "--user",
          "summary": "Use the current user’s service manager",
          "detail": "Selects units managed for the calling user."
        },
        {
          "argument": "",
          "flag": "--system",
          "summary": "Use the system service manager",
          "detail": "This is the default manager."
        },
        {
          "argument": "",
          "flag": "--no-pager",
          "summary": "Write output without a pager"
        },
        {
          "argument": "",
          "flag": "--no-legend",
          "summary": "Applies to table legends only",
          "detail": "Property output has no table legend. Use --value to omit property names."
        },
        {
          "argument": "",
          "flag": "--full",
          "summary": "Applies to width-limited listings and status",
          "detail": "Property values from show are printed independently of the status display width."
        },
        {
          "argument": "",
          "flag": "--all",
          "summary": "Include properties with empty values",
          "detail": "Without a unit or job, show prints manager properties. Use --property=NAME to request a specific property even when it is empty."
        },
        {
          "argument": "TYPE",
          "flag": "--type=",
          "summary": "Show properties for matching unit types",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "enumeration",
                "meaning": "systemd unit types",
                "bare": {
                  "state": "not_applicable",
                  "reason": "This is a text/selector grammar, not an unsuffixed scalar measurement"
                },
                "forms": [
                  {
                    "id": "text",
                    "notation": "expression",
                    "syntax": "VALUE",
                    "grammar": "Comma-separated unit-type names such as service, socket, target, timer, device, mount, automount, swap, path, slice and scope; help requests the supported type list."
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Do not add a unit-type filter."
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "The option requires its operand"
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "systemd"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "257"
                    ]
                  },
                  "platform": {
                    "state": "not_applicable",
                    "reason": "Parameter interpretation is described here; operating-system availability is not asserted"
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed by this parameter contract"
                  }
                },
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://raw.githubusercontent.com/systemd/systemd/v257/man/systemctl.xml",
                      "locator": "--type"
                    }
                  ]
                }
              }
            ]
          },
          "detail": "With no operand or a unit glob, select units by type. An explicit unit name is looked up directly. Ubuntu 24.04 and 26.04 require a value after =."
        },
        {
          "argument": "STATE",
          "flag": "--state=",
