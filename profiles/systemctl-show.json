                  "status": "verified"
                },
                "subject": "Recent journal lines for status output",
                "when_absent": {
                  "form": "lines",
                  "state": "known",
                  "value": "10"
                },
                "when_value_omitted": {
                  "reason": "This option requires an operand",
                  "state": "not_accepted"
                }
              }
            ]
          }
        },
