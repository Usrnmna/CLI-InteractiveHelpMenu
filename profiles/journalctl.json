        {
          "flag": "--priority=",
          "argument": "RANGE",
          "summary": "Select severity 0-7; lower numbers are more severe",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "level",
                "meaning": "Syslog severity threshold",
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://www.freedesktop.org/software/systemd/man/257/journalctl.html",
                      "locator": "--since, --until, --priority, --boot and --lines"
                    }
                  ]
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "systemd"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "257"
                    ]
                  },
                  "platform": {
                    "state": "known",
                    "values": [
                      "Linux"
                    ]
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed"
                  }
                },
                "bare": {
                  "state": "accepted",
                  "form": "priority"
                },
                "forms": [
                  {
                    "id": "priority",
                    "notation": "number",
                    "syntax": "N",
                    "bounds": {
                      "min": "0",
                      "max": "7"
                    },
                    "grammar": "Integers 0 through 7; one level includes itself and all lower, more severe levels"
                  },
                  {
                    "id": "names",
                    "notation": "expression",
                    "syntax": "emerg|alert|crit|err|warning|notice|info|debug",
                    "grammar": "The documented names correspond to levels 0,1,2,3,4,5,6,7 respectively"
                  },
                  {
                    "id": "range",
                    "notation": "expression",
                    "syntax": "FROM..TO",
                    "grammar": "Numeric or named priority endpoints; both endpoints are included"
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "No priority filter is added by this option"
                },
                "when_value_omitted": {
                  "state": "not_accepted",
                  "reason": "This option requires an operand"
                },
                "ordering": "Lower numerical levels mean greater severity"
              }
            ]
          },
          "detail": "systemd 257: emerg=0, alert=1, crit=2, err=3, warning=4, notice=5, info=6, debug=7. A single level includes that level and all numerically lower (more severe) levels. FROM..TO selects an inclusive range; the documented names may replace numbers. This is a severity scale, not a percentage."
        },
