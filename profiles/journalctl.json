        {
          "argument": "TIME",
          "detail": "systemd 257: use calendar timestamps, now/today/yesterday/tomorrow, signed relative time spans, or @SECONDS since the Unix epoch. Unqualified calendar times use the local timezone; an explicit zone changes it. Omitted date/time components follow systemd.time rules. This is not a generic milliseconds value. The cutoff is inclusive.",
          "flag": "--since=",
          "summary": "Select messages at or after a calendar or relative time",
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "applicability": {
                  "chip": {
                    "reason": "No chip-specific interpretation is claimed",
                    "state": "not_applicable"
                  },
                  "implementation": {
                    "state": "known",
                    "values": [
                      "systemd"
                    ]
                  },
                  "platform": {
                    "state": "known",
                    "values": [
                      "Linux"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "257"
                    ]
                  }
                },
                "bare": {
                  "reason": "A bare numeric string is not a universal scalar timestamp form; use an explicit documented calendar/relative/@epoch form",
                  "state": "not_accepted"
                },
                "forms": [
                  {
                    "grammar": "Calendar form with documented omitted components; quote a value containing spaces",
                    "id": "calendar",
                    "notation": "expression",
                    "syntax": "YYYY-MM-DD HH:MM:SS[.fraction] [ZONE]"
                  },
                  {
                    "grammar": "Signed spans are relative to the current time; use documented time units rather than assume milliseconds",
                    "id": "relative",
                    "notation": "expression",
                    "syntax": "-TIMESPAN | +TIMESPAN | now | today | yesterday | tomorrow"
                  },
                  {
                    "grammar": "Seconds since the Unix epoch with an explicit @ prefix",
                    "id": "epoch",
                    "notation": "expression",
                    "syntax": "@SECONDS",
                    "unit": {
                      "base": "second",
                      "multiplier": "1"
                    }
                  }
                ],
                "kind": "timestamp",
                "meaning": "Journal time cutoff, at or after the specified time",
                "review": {
                  "references": [
                    {
                      "locator": "--since, --until, --priority, --boot and --lines",
                      "source": "https://www.freedesktop.org/software/systemd/man/257/journalctl.html"
                    },
                    {
                      "locator": "Parsing Timestamps",
                      "source": "https://www.freedesktop.org/software/systemd/man/257/systemd.time.html"
                    }
                  ],
                  "status": "verified"
                },
                "time_basis": "Calendar time uses the local timezone unless one is supplied; @seconds use the Unix epoch; signed relative forms use the current time",
                "when_absent": {
                  "meaning": "This option adds no lower time cutoff",
                  "state": "known"
                },
                "when_value_omitted": {
                  "reason": "This option requires an operand",
                  "state": "not_accepted"
                }
              }
            ]
          }
        },
