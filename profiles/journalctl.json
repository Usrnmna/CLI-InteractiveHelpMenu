          "flag": "--user",
          "argument": "",
          "summary": "Read user journals"
        },
        {
          "flag": "--reverse",
          "argument": "",
          "summary": "Show newest messages first"
        },
        {
          "flag": "--directory=",
          "argument": "PATH",
          "summary": "Read journal files from a directory"
        },
        {
          "flag": "--boot=",
          "argument": "ID",
          "summary": "Select boot ID or ordinal; omitted ID means current boot",
          "argument_optional": true,
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "identifier",
                "meaning": "Boot selection by ID or signed ordinal offset",
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://www.freedesktop.org/software/systemd/man/257/journalctl.html",
                      "locator": "--since, --until, --priority, --boot and --lines"
                    }
                  ]
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "systemd"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "257"
                    ]
                  },
                  "platform": {
                    "state": "known",
                    "values": [
                      "Linux"
                    ]
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed"
                  }
                },
                "bare": {
                  "state": "accepted",
                  "form": "offset"
                },
                "forms": [
                  {
                    "id": "offset",
                    "notation": "number",
                    "syntax": "N",
                    "grammar": "Positive offsets count from the oldest boot starting at 1; zero and negative offsets count from the newest boot"
                  },
                  {
                    "id": "id",
                    "notation": "expression",
                    "syntax": "ID[+|-OFFSET]",
                    "grammar": "32 hexadecimal boot-ID characters, optionally followed by a signed offset relative to that ID"
                  },
                  {
                    "id": "all",
                    "notation": "literal",
                    "syntax": "all",
                    "tokens": [
                      "all"
                    ],
                    "case": "sensitive",
                    "meaning": "Cancel a previous boot restriction"
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "Do not restrict output to a boot unless another option implies it"
                },
                "when_value_omitted": {
                  "state": "known",
                  "meaning": "Select the current boot, which can differ from the last boot in another journal directory"
                },
                "subject": "Journal boot IDs or chronological boot offsets"
              }
            ]
          },
          "detail": "systemd 257: a 32-character hexadecimal ID identifies a boot. Without an ID, 1 is the oldest boot, 2 the next; 0/-0 is the newest, -1 the preceding boot. An offset after an ID is relative to that boot. Omitting the operand selects the current boot, which can differ from newest when reading another journal directory. all removes an earlier boot restriction. Offsets count boots, not seconds."
        },
        {
          "flag": "--lines=",
          "argument": "LINES",
          "summary": "Limit journal events; omitted value is 10, all removes cap",
          "argument_optional": true,
          "value_semantics": {
            "schema_version": 1,
            "variants": [
              {
                "kind": "count",
                "meaning": "Journal events displayed",
                "review": {
                  "status": "verified",
                  "references": [
                    {
                      "source": "https://www.freedesktop.org/software/systemd/man/257/journalctl.html",
                      "locator": "--since, --until, --priority, --boot and --lines"
                    }
                  ]
                },
                "applicability": {
                  "implementation": {
                    "state": "known",
                    "values": [
                      "systemd"
                    ]
                  },
                  "version": {
                    "state": "known",
                    "values": [
                      "257"
                    ]
                  },
                  "platform": {
                    "state": "known",
                    "values": [
                      "Linux"
                    ]
                  },
                  "chip": {
                    "state": "not_applicable",
                    "reason": "No chip-specific interpretation is claimed"
                  }
                },
                "bare": {
                  "state": "accepted",
                  "form": "events"
                },
                "forms": [
                  {
                    "id": "events",
                    "notation": "number",
                    "syntax": "N",
                    "bounds": {
                      "min": "1"
                    },
                    "grammar": "Positive integer count of journal events"
                  },
                  {
                    "id": "all",
                    "notation": "literal",
                    "syntax": "all",
                    "tokens": [
                      "all"
                    ],
                    "case": "sensitive",
                    "meaning": "Disable the event-count limit"
                  },
                  {
                    "id": "oldest",
                    "notation": "expression",
                    "syntax": "+N",
                    "grammar": "Count N events from the oldest end rather than the newest"
                  }
                ],
                "when_absent": {
                  "state": "known",
                  "meaning": "No explicit event cap, except an implied/default cap from follow or pager modes"
                },
                "when_value_omitted": {
                  "state": "known",
                  "form": "events",
                  "value": "10"
                },
                "subject": "Journal events, not necessarily physical terminal lines"
              }
            ]
          },
          "detail": "systemd 257: a positive integer counts journal events from the newest end; +N counts from the oldest. all removes the cap. With no operand the value is 10. Follow and pager modes can imply their own caps."
        }
      ]
    }
