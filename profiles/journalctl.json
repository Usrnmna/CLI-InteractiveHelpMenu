                  }
                },
                "bare": {
                  "form": "priority",
                  "state": "accepted"
                },
                "forms": [
                  {
                    "bounds": {
                      "max": "7",
                      "min": "0"
                    },
                    "grammar": "Integers 0 through 7; one level includes itself and all lower, more severe levels",
                    "id": "priority",
                    "notation": "number",
                    "syntax": "N"
                  },
                  {
                    "grammar": "The documented names correspond to levels 0,1,2,3,4,5,6,7 respectively",
                    "id": "names",
                    "notation": "expression",
                    "syntax": "emerg|alert|crit|err|warning|notice|info|debug"
                  },
                  {
                    "grammar": "Numeric or named priority endpoints; both endpoints are included",
                    "id": "range",
                    "notation": "expression",
                    "syntax": "FROM..TO"
                  }
                ],
                "kind": "level",
                "meaning": "Syslog severity threshold",
                "ordering": "Lower numerical levels mean greater severity",
                "review": {
                  "references": [
                    {
                      "locator": "--since, --until, --priority, --boot and --lines",
                      "source": "https://www.freedesktop.org/software/systemd/man/257/journalctl.html"
                    }
                  ],
                  "status": "verified"
                },
                "when_absent": {
                  "meaning": "No priority filter is added by this option",
                  "state": "known"
                },
                "when_value_omitted": {
                  "reason": "This option requires an operand",
                  "state": "not_accepted"
                }
