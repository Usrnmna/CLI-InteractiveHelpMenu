        {
          "argument": "ID",
          "argument_optional": true,
          "detail": "Use bare --boot for the current boot, or the newest recorded boot with --directory=. Use 1 for the oldest boot, 0 for the newest and -1 for the previous boot. Enter a value after =. Use all to clear the filter. Ubuntu 24.04 ignores the offset in ID+offset.",
          "flag": "--boot=",
          "summary": "Select a boot by ID or offset",
