# Linux tools require LF checkouts, including when Git runs on Windows.
* text=auto eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
*.bash text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
# JSON metadata and text help excerpts use normalized LF like authored source.
*.md text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.c text eol=lf
*.checksum text eol=lf
*.txt text eol=lf
*.1 text eol=lf

# Preserve media and compressed manual fixtures byte for byte.
*.gif binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.gz binary
*.run binary
releases/**/cli-help-v*-linux-x86_64 binary
