# Match Git's LF policy without rewriting fixture whitespace on editor save.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,md,toml}]
indent_size = 2

# Markdown hard breaks and help-parser fixtures may contain significant spaces.
[*.md]
trim_trailing_whitespace = false

[tests/fixtures/help/**]
trim_trailing_whitespace = false

# Preserve printed padding, tab-delimited fields and the checksum of captured text.
[tests/fixtures/**/*.{txt,tsv}]
trim_trailing_whitespace = false
insert_final_newline = unset

# A final tab can represent an empty image or provider field in the audit ledger.
[docs/ubuntu-command-coverage/*.tsv]
trim_trailing_whitespace = false

# A blank context line in a benchmark patch contains one significant space.
[tools/menu_benchmark/**/*.patch]
trim_trailing_whitespace = false

# Preserve disposable copies, generated evidence, and downloaded tool bytes.
# Maintained review annotations remain subject to the normal JSON settings.
[{.cache,dist,generated-help,tests/reports}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[*.{gif,png,jpg,jpeg,webp,ico,gz,xz,run}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# Compiled standalone launchers have no filename extension.
[cli-help]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[cli-help-v*-linux-x86_64]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
