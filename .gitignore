# Python bytecode, local environments, and analysis caches.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local test evidence, link reports, and generated help collections.
# Third-party test binaries, downloads, and isolated environments belong in .cache/.
# Maintained help excerpts under tests/fixtures/help/ remain tracked.
# Numerical inventory facts belong in tests/reports/numerical-inventory/.
# Curated decisions under docs/numerical-inventory/ remain maintained inputs.
# Raw media recordings, scene/cursor assertions, and replay reports belong in
# tests/reports/; public documentation GIFs and PNGs under docs/assets/ stay tracked.
**/tests/reports/
generated-help/
.cache/
# Protect known private homes in both root and nested isolated environments.
# Maintained profiles, drivers, help excerpts, and environment templates stay visible.
.azure/
.aws/
.ssh/
.gnupg/
.kube/
.docker/
.dotnet/
.nuget/
.bun/
.ansible/
.arduino15/
**/.config/gcloud/
**/.config/gh/
**/.config/cli-help/
**/.config/containers/
**/.local/share/containers/
**/.local/share/cli-interactive-help/
.npm/
node_modules/
.lycheecache
# Local candidates, reproducibility builds, and manifests remain private outputs.
# Curated historical artifacts under releases/ remain eligible for tracking.
dist/
/lychee/
# Private credential/history files in checkout-local homes.
.git-credentials
.netrc
.pypirc
.bash_history
.python_history
.lesshst
.wget-hsts

# Application/test sessions when TMPDIR points anywhere inside the checkout.
cli-help-media-*/
cli-help-probe-*/
cli-help-review-*/
cli-help-screen-*/
cli-help-description-screen-*/
cli-help-sanitized-screen-*/
cli-help-replay-*/
cli-help-build-*/
cli-help-installer.*/
cli-help-ignore-*/
cli-help-inventory-*/
cli-help-capture-*/
cli-help-functional-review-*/
cli-help-workflow-verification-*/
.cli-help-rc-*
.review-state-*
.cli-help-install.json
# Standalone local launcher builds and installed copies at any depth.
# Versioned launchers under releases/ remain eligible for tracking.
cli-help
.review-backups/
.import.lock
.scan.lock
*.install.lock
*.update-backup-*/
*.update-review-backup-*/
*.release-update-*/
.cli-help-stage-*/
.cli-help-write-*.tmp
*.cli-help-backup-*

# Local environment values; example configuration remains eligible for tracking.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# Editor recovery files and operating-system metadata.
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
