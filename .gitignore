# Python bytecode, local environments, and analysis caches.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local test evidence, link reports, and generated help collections.
/tests/reports/
/generated-help/
/.cache/
/.lycheecache
/dist/
/lychee/
.review-backups/
.import.lock
.scan.lock
*.install.lock
*.update-backup-*/
*.update-review-backup-*/
.cli-help-stage-*/
*.cli-help-backup-*

# Local environment values; example configuration remains eligible for tracking.
.env
.env.*
!.env.example
!.env.sample

# Editor recovery files and operating-system metadata.
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
