# Python bytecode, local environments, and analysis caches.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local test evidence, link reports, and generated help collections.
# Third-party test binaries, downloads, and isolated environments belong in .cache/.
# Maintained help excerpts under tests/fixtures/help/ remain tracked.
# Raw media recordings, scene/cursor assertions, and replay reports belong in
# tests/reports/; public documentation GIFs and PNGs under docs/assets/ stay tracked.
/tests/reports/
/generated-help/
/.cache/
# Tool homes are normally isolated below .cache/live-followup/. Protect accidental
# checkout-local homes without hiding maintained drivers, profiles, or captures.
/.azure/
/.aws/
/.ssh/
/.gnupg/
/.kube/
/.docker/
/.dotnet/
/.nuget/
/.bun/
/.ansible/
/.arduino15/
/.config/gcloud/
/.config/gh/
/.config/cli-help/
/.config/containers/
/.local/share/containers/
/.npm/
node_modules/
/.lycheecache
/dist/
/lychee/
# Private credential/history files when a tool HOME points at the checkout.
/.git-credentials
/.netrc
/.pypirc
/.bash_history
/.python_history
/.lesshst
/.wget-hsts

# Application/test temporary sessions when TMPDIR points at the checkout root.
/cli-help-media-*/
/cli-help-probe-*/
/cli-help-review-*/
/cli-help-screen-*/
/cli-help-build-*/
/cli-help-installer.*/
/cli-help-ignore-*/
/cli-help-capture-*/
/cli-help-functional-review-*/
/cli-help-workflow-verification-*/
/.cli-help-rc-*
/.review-state-*
/.cli-help-install.json
# Standalone local launcher builds; published release assets remain eligible.
/cli-help
.review-backups/
.import.lock
.scan.lock
*.install.lock
*.update-backup-*/
*.update-review-backup-*/
*.release-update-*/
.cli-help-stage-*/
.cli-help-write-*.tmp
*.cli-help-backup-*

# Local environment values; example configuration remains eligible for tracking.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# Editor recovery files and operating-system metadata.
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
