  "command": "cargo",
  "global_values": [
    "--color",
    "--config",
    "-C"
  ],
  "global_flags": [
    "--offline",
    "--locked",
    "--frozen",
    "-q",
    "--quiet",
    "-v",
    "--verbose"
  ],
  "paths": [
