{
  "command": "npm",
  "global_values": ["--prefix", "--registry", "--cache", "--userconfig"],
  "global_flags": ["--global", "-g", "--offline", "--ignore-scripts"],
  "paths": [
    {"command": [], "help": ["--help"], "man": "npm"},
    {"command": ["install"], "help": ["--help", "install"], "man": "npm-install"},
    {"command": ["run"], "help": ["--help", "run"], "man": "npm-run-script", "stop_at_positional": true},
    {"command": ["publish"], "help": ["--help", "publish"], "man": "npm-publish"}
  ]
}
