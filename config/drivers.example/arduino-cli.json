{
  "command": "arduino-cli",
  "global_values": [
    "--config-file",
    "--config-dir",
    "--log-file",
    "--log-format",
    "--log-level"
  ],
  "global_flags": [
    "--json",
    "--log",
    "--no-color"
  ],
  "paths": [
    {
