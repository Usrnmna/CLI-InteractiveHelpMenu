{
  "command": "ruff",
  "global_values": [
    "--config"
  ],
  "global_flags": [
    "--isolated",
    "-q",
    "--quiet",
    "-v",
    "--verbose"
  ],
  "paths": [
    {
      "command": [
        "check"
      ],
      "help": [
        "check",
        "--help"
      ],
      "man": null,
      "stop_at_positional": false
    },
    {
      "command": [
        "format"
      ],
      "help": [
        "format",
        "--help"
      ],
      "man": null,
      "stop_at_positional": false
    }
  ]
}
