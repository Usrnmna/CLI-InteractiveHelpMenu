{
  "command": "restic",
  "global_values": [
    "--repo",
    "-r",
    "--password-file",
    "--cache-dir"
  ],
  "global_flags": [
    "--no-cache",
    "-q",
    "--quiet",
    "-v",
    "--verbose"
  ],
  "paths": [
    {
      "command": [],
      "help": [
        "--help"
      ],
      "man": null
    },
    {
      "command": [
        "backup"
      ],
      "help": [
        "backup",
        "--help"
      ],
      "man": null,
      "stop_at_positional": false
    }
  ]
}
